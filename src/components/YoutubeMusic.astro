---
import { Music, ExternalLink, ChevronLeft, ChevronRight } from "lucide-astro";

import { translations } from "../i18n/translations.js";
import { Image } from "astro:assets";
import ytMusicCover from "../assets/images/yt-music.jpg";

const t = translations.en;

interface Track {
  snippet: {
    title: string;
    resourceId: {
      videoId: string;
    };
    thumbnails: {
      high?: { url: string };
      default: { url: string };
    };
    videoOwnerChannelTitle: string;
  };
}

const playlistId = "PLr8nCm0aobtRA0SAeeK4Fa9tbWf-r-ton";
const apiKey = import.meta.env.YOUTUBE_API_KEY;

const url = `https://www.googleapis.com/youtube/v3/playlistItems?part=snippet&maxResults=15&playlistId=${playlistId}&key=${apiKey}`;

let tracks: Track[] = [];
try {
  const response = await fetch(url);
  const data = await response.json();
  tracks = data.items || [];
} catch (e) {
  console.error("Error cargando la playlist", e);
}

const cleanTitle = (title: string) => {
  return title
    .replace(/\s*\([^)]*\)/g, "")
    .replace(/\s*\/\/.*$/, "")
    .trim();
};

const gradients = [
  "from-indigo-500/20 to-purple-500/20",
  "from-blue-500/20 to-cyan-500/20",
  "from-emerald-500/20 to-teal-500/20",
  "from-rose-500/20 to-pink-500/20",
  "from-amber-500/20 to-orange-500/20",
];
---

<section id="music" class="py-12 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <div class="yt-music-card opacity-0 translate-y-10">
      <!-- Studio Header -->
      <div class="space-y-10 mb-20">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px bg-accent"></span>
          <span
            class="text-[10px] font-black uppercase tracking-[0.4em] text-text-muted"
            data-i18n="music.badge">{t.music.badge}</span
          >
        </div>

        <div class="space-y-6">
          <h2
            class="text-6xl md:text-8xl font-[Outfit] font-black text-text-heading leading-[0.9] tracking-tighter"
            data-i18n="music.title"
          >
            {t.music.title}
          </h2>
          <p
            class="text-xl text-text-muted font-light leading-relaxed max-w-xl"
            data-i18n="music.subtitle"
          >
            {t.music.subtitle}
          </p>
        </div>
      </div>

      <div
        class="mb-8 p-px rounded-2xl bg-linear-to-r from-accent/20 to-rose-accent/20"
      >
        <div
          class="bg-surface/80 backdrop-blur-sm rounded-[calc(1rem-1px)] overflow-hidden border border-th-border"
        >
          <div class="grid md:grid-cols-[300px_1fr] gap-6 p-6">
            <div
              class="relative rounded-xl overflow-hidden shadow-lg aspect-square md:aspect-auto"
            >
              <Image
                src={ytMusicCover}
                alt="90 degree angle"
                width={400}
                height={400}
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              <div
                class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent"
              >
              </div>
            </div>

            <div class="flex flex-col justify-center space-y-4">
              <div>
                <h3
                  class="text-2xl md:text-3xl font-bold text-text-primary mb-2"
                >
                  90 degree angle
                </h3>
                <p class="text-text-muted text-sm mb-3">
                  frysccou • <span data-i18n="music.playlistLabel"
                    >{t.music.playlistLabel}</span
                  > • <span data-i18n="music.publicLabel"
                    >{t.music.publicLabel}</span
                  > • 2026
                </p>
                <p class="text-text-muted text-sm line-clamp-3 leading-relaxed">
                  what about 88.78 degree angle??
                </p>
              </div>

              <div
                class="grid grid-cols-3 gap-4 pt-4 border-t border-th-border-secondary"
              >
                <div class="text-center">
                  <div class="text-xl md:text-2xl font-bold text-accent">
                    +200
                  </div>
                  <div
                    class="text-xs text-text-muted uppercase tracking-wide"
                    data-i18n="music.tracksLabel"
                  >
                    {t.music.tracksLabel}
                  </div>
                </div>
                <div class="text-center">
                  <div class="text-xl md:text-2xl font-bold text-accent">
                    12h
                  </div>
                  <div
                    class="text-xs text-text-muted uppercase tracking-wide"
                    data-i18n="music.durationLabel"
                  >
                    {t.music.durationLabel}
                  </div>
                </div>
                <div class="text-center">
                  <div class="text-xl md:text-2xl font-bold text-accent">
                    31K
                  </div>
                  <div
                    class="text-xs text-text-muted uppercase tracking-wide"
                    data-i18n="music.viewsLabel"
                  >
                    {t.music.viewsLabel}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="relative">
        <button
          aria-label="Scroll left"
          class="yt-arrow left absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-surface/70 rounded-full p-2 shadow-md hover:bg-surface"
          onclick="document.getElementById('yt-track-list')?.scrollBy({left: -320, behavior: 'smooth'})"
        >
          <ChevronLeft class="w-5 h-5" />
        </button>
        <div
          id="yt-track-list"
          class="flex gap-3 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide scroll-smooth"
        >
          {
            tracks.map((track: Track, index) => (
              <a
                href={`https://music.youtube.com/watch?v=${track.snippet.resourceId.videoId}`}
                target="_blank"
                class="group relative shrink-0 w-44 p-px rounded-xl bg-linear-to-r from-accent/20 to-rose-accent/20 hover:from-accent/40 hover:to-rose-accent/40 transition-all duration-500 hover:shadow-lg hover:shadow-accent/10 snap-start"
              >
                <div class="bg-surface/80 backdrop-blur-sm rounded-[calc(0.75rem-1px)] p-2 h-full border border-th-border hover:border-accent/30 transition-all duration-500">
                  <div
                    class={`relative aspect-square rounded-lg overflow-hidden mb-2 bg-linear-to-br ${gradients[index % gradients.length]} flex items-center justify-center p-4`}
                  >
                    <div class="absolute inset-0 bg-white/10 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                    <div class="bg-white/30 backdrop-blur-md rounded-full w-10 h-10 flex items-center justify-center shadow-lg border border-white/40 transform group-hover:scale-110 group-hover:rotate-12 transition-all duration-500">
                      <Music class="w-5 h-5 text-accent" />
                    </div>

                    <div class="absolute bottom-1.5 right-1.5 w-7 h-7 rounded-full bg-accent flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 shadow-lg">
                      <ExternalLink class="w-3 h-3 text-white" />
                    </div>
                  </div>

                  <div class="space-y-0.5">
                    <h3 class="text-[10px] font-bold text-text-primary line-clamp-2 leading-tight group-hover:text-accent transition-colors duration-300">
                      {cleanTitle(track.snippet.title)}
                    </h3>
                    <p class="text-[9px] text-text-muted truncate">
                      {track.snippet.videoOwnerChannelTitle.replace(
                        " - Topic",
                        "",
                      )}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <button
          aria-label="Scroll right"
          class="yt-arrow right absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-surface/70 rounded-full p-2 shadow-md hover:bg-surface"
          onclick="document.getElementById('yt-track-list')?.scrollBy({left: 320, behavior: 'smooth'})"
        >
          <ChevronRight class="w-5 h-5" />
        </button>
      </div>

      <div class="mt-6 text-center">
        <a
          href={`https://music.youtube.com/playlist?list=${playlistId}`}
          target="_blank"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent text-white font-bold text-xs hover:bg-accent/90 hover:shadow-lg hover:shadow-accent/20 transition-all duration-300"
          data-i18n="music.viewPlaylist"
        >
          <Music class="w-3.5 h-3.5" />
          {t.music.viewPlaylist}
          <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .yt-music-card {
    will-change: transform, opacity;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.to(".yt-music-card", {
      scrollTrigger: {
        trigger: "#music",
        start: "top 85%",
      },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power3.out",
    });
  });
</script>
