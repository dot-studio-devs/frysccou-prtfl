---
import { Github, Linkedin, Instagram, Mail } from "lucide-astro";
const currentYear = new Date().getFullYear();
---

<footer class="section-animate relative py-20 border-t border-white/5 bg-surface overflow-hidden">
  <div class="max-w-7xl mx-auto px-8 sm:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">

      <!-- Branding -->
      <div class="space-y-6">
        <a href="/" class="inline-flex items-center group">
          <img
            src="/brand/android-chrome-192x192.png"
            alt="YSC"
            class="h-9 w-auto transition-opacity duration-300 group-hover:opacity-70"
          />
        </a>
        <p class="text-white/30 text-sm leading-relaxed">
          Full Stack Engineering studio based in Buenos Aires.
          Building premium digital experiences, end-to-end.
        </p>
        <div class="flex items-center gap-2 text-white/30 text-[10px] font-bold uppercase tracking-widest">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-accent"></span>
          </span>
          <span>Available for work</span>
        </div>
      </div>

      <!-- Logo central grande -->
      <div class="flex items-center justify-center">
        <a href="/" class="group opacity-[0.06] hover:opacity-[0.12] transition-opacity duration-500">
          <img
            src="/brand/android-chrome-192x192.png"
            alt="YSC"
            class="w-48 h-48 object-contain"
          />
        </a>
      </div>

      <!-- Connect -->
      <div class="space-y-6 md:text-right">
        <h4 class="text-white text-[10px] font-black uppercase tracking-widest">Connect</h4>
        <div class="flex items-center gap-3 md:justify-end">
          <a
            href="https://github.com/esspindola"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl border border-white/10 flex items-center justify-center text-white/30 hover:text-white hover:border-white/30 transition-all duration-300"
            aria-label="GitHub"
          >
            <Github class="w-4 h-4" />
          </a>
          <a
            href="https://www.linkedin.com/in/espindola-francisco"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl border border-white/10 flex items-center justify-center text-white/30 hover:text-white hover:border-white/30 transition-all duration-300"
            aria-label="LinkedIn"
          >
            <Linkedin class="w-4 h-4" />
          </a>
          <a
            href="https://instagram.com/frysccou"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl border border-white/10 flex items-center justify-center text-white/30 hover:text-white hover:border-white/30 transition-all duration-300"
            aria-label="Instagram"
          >
            <Instagram class="w-4 h-4" />
          </a>
          <a
            href="mailto:franespindola71@gmail.com"
            class="w-10 h-10 rounded-xl border border-white/10 flex items-center justify-center text-white/30 hover:text-white hover:border-white/30 transition-all duration-300"
            aria-label="Email"
          >
            <Mail class="w-4 h-4" />
          </a>
        </div>
        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="text-[10px] font-bold uppercase tracking-widest text-white/30 hover:text-white transition-colors flex items-center gap-2 group md:justify-end md:ml-auto"
        >
          Back to top
          <div class="w-7 h-7 rounded-full border border-white/10 flex items-center justify-center group-hover:border-white/30 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
          </div>
        </button>
      </div>

    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/30 text-[10px] font-bold uppercase tracking-widest">
        © {currentYear} YSC by frysccou — All rights reserved
      </p>
      <p class="text-white/30 text-[10px] font-bold uppercase tracking-widest order-first md:order-last">
        Buenos Aires, Argentina
      </p>
    </div>
  </div>
</footer>
