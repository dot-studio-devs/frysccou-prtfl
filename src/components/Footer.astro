---
import { translations } from "../i18n/translations.js";
import {
  Github,
  Linkedin,
  Instagram,
  Heart,
  Mail,
  ArrowUpRight,
} from "lucide-astro";
const t = translations.en;
const currentYear = new Date().getFullYear();
---

<footer
  class="section-animate relative py-20 border-t border-th-border bg-surface overflow-hidden"
>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-px bg-linear-to-r from-transparent via-th-border-secondary to-transparent"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 mb-16">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex items-center group mb-6">
          <img
            src="/ysc-transparente.png"
            alt="Frysccou"
            class="h-10 w-auto transition-transform duration-500 group-hover:scale-105"
          />
        </a>
        <p
          class="text-text-muted text-sm max-w-sm leading-relaxed mb-8"
          data-i18n="footer.description"
        >
          {t.footer.description}
        </p>
        <div
          class="flex items-center gap-2 text-text-muted text-xs font-bold uppercase tracking-widest"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span data-i18n="footer.status">{t.footer.status}</span>
        </div>
      </div>

      <div class="lg:col-span-3 grid grid-cols-2 gap-8">
        <div class="space-y-6">
          <h4
            class="text-text-primary text-xs font-black uppercase tracking-tighter"
            data-i18n="footer.explore"
          >
            {t.footer.explore}
          </h4>
          <ul class="space-y-4">
            <li>
              <a
                href="/#about"
                class="text-text-muted hover:text-accent text-sm font-medium transition-colors flex items-center gap-1 group"
                ><span data-i18n="nav.about">{t.nav.about}</span>
                <ArrowUpRight
                  class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-all -translate-y-0.5"
                /></a
              >
            </li>
            <li>
              <a
                href="/#skills"
                class="text-text-muted hover:text-accent text-sm font-medium transition-colors flex items-center gap-1 group"
                ><span data-i18n="nav.skills">{t.nav.skills}</span>
                <ArrowUpRight
                  class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-all -translate-y-0.5"
                /></a
              >
            </li>
            <li>
              <a
                href="/#projects"
                class="text-text-muted hover:text-accent text-sm font-medium transition-colors flex items-center gap-1 group"
                ><span data-i18n="nav.projects">{t.nav.projects}</span>
                <ArrowUpRight
                  class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-all -translate-y-0.5"
                /></a
              >
            </li>
          </ul>
        </div>
        <div class="space-y-6">
          <h4
            class="text-text-primary text-xs font-black uppercase tracking-tighter"
            data-i18n="footer.services"
          >
            {t.footer.services}
          </h4>
          <ul class="space-y-4">
            <li>
              <a
                href="/#marketplace"
                class="text-text-muted hover:text-accent text-sm font-medium transition-colors flex items-center gap-1 group"
                ><span data-i18n="nav.marketplace">{t.nav.marketplace}</span>
                <ArrowUpRight
                  class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-all -translate-y-0.5"
                /></a
              >
            </li>
            <li>
              <a
                href="https://dot-studio.site"
                target="_blank"
                class="text-text-muted hover:text-accent text-sm font-medium transition-colors flex items-center gap-1 group"
                ><span data-i18n="nav.aboutStudio">{t.nav.aboutStudio}</span>
                <ArrowUpRight
                  class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-all -translate-y-0.5"
                /></a
              >
            </li>
          </ul>
        </div>
      </div>

      <div class="lg:col-span-4 flex flex-col items-start lg:items-end">
        <h4
          class="text-text-primary text-xs font-black uppercase tracking-tighter mb-6"
          data-i18n="footer.connect"
        >
          {t.footer.connect}
        </h4>
        <div class="flex items-center gap-3 mb-8">
          <a
            href="https://github.com/esspindola"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 rounded-xl bg-surface hover:bg-accent border border-th-border hover:border-accent flex items-center justify-center text-text-secondary hover:text-white transition-all duration-500 hover:shadow-lg hover:shadow-accent/40"
            aria-label="GitHub"
          >
            <Github
              class="w-5 h-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="https://www.linkedin.com/in/espindola-francisco"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 rounded-xl bg-surface hover:bg-accent border border-th-border hover:border-accent flex items-center justify-center text-text-secondary hover:text-white transition-all duration-500 hover:shadow-lg hover:shadow-accent/40"
            aria-label="LinkedIn"
          >
            <Linkedin
              class="w-5 h-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="https://instagram.com/frysccou"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 rounded-xl bg-surface hover:bg-accent border border-th-border hover:border-accent flex items-center justify-center text-text-secondary hover:text-white transition-all duration-500 hover:shadow-lg hover:shadow-accent/40"
            aria-label="Instagram"
          >
            <Instagram
              class="w-5 h-5 transition-transform group-hover:scale-110"
            />
          </a>
          <a
            href="mailto:franespindola71@gmail.com"
            class="w-11 h-11 rounded-xl bg-surface hover:bg-accent border border-th-border hover:border-accent flex items-center justify-center text-text-secondary hover:text-white transition-all duration-500 hover:shadow-lg hover:shadow-accent/40"
            aria-label="Email"
          >
            <Mail class="w-5 h-5 transition-transform group-hover:scale-110" />
          </a>
        </div>
        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="text-xs font-bold uppercase tracking-widest text-text-muted hover:text-accent transition-colors flex items-center gap-2 group"
        >
          <span data-i18n="footer.backToTop">{t.footer.backToTop}</span>
          <div
            class="w-8 h-8 rounded-full border border-th-border-secondary flex items-center justify-center group-hover:border-accent group-hover:bg-accent transition-all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 group-hover:text-white transition-colors"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg
            >
          </div>
        </button>
      </div>
    </div>

    <div
      class="pt-10 border-t border-th-border-secondary/50 flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <div class="flex items-center gap-2 text-text-muted text-sm font-medium">
        <span data-i18n="footer.madeWith">{t.footer.madeWith}</span>
        <Heart
          class="w-4 h-4 text-rose-accent fill-rose-accent animate-pulse"
        />
        <span data-i18n="footer.by">{t.footer.by}</span>
      </div>

      <p
        class="text-text-muted text-[10px] font-bold uppercase tracking-widest order-first md:order-last"
      >
        © {currentYear} • <span data-i18n="footer.rights"
          >{t.footer.rights}</span
        >
      </p>
    </div>
  </div>
</footer>
