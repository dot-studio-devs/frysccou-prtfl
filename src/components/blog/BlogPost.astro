---
import type { CollectionEntry } from "astro:content";
import { ArrowLeft, Clock, Tag, Share2, ArrowUp } from "lucide-astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;

const formattedDate = data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="blog-post-wrapper">
  <header class="blog-post-header">
    <div class="blog-post-header-inner">
      <a href="/blog" class="blog-back-link" id="blog-back-btn">
        <ArrowLeft class="w-4 h-4" />
        <span class="back-label" data-i18n="blog.backToList">Back to Blog</span>
      </a>

      <div class="blog-tags-row">
        {
          data.tags.map((tag: string) => (
            <span class="blog-tag">
              <Tag class="w-3 h-3" />
              {tag}
            </span>
          ))
        }
      </div>

      <h1 class="blog-post-title">{data.title}</h1>
      <p class="blog-post-summary">{data.summary}</p>

      <div class="blog-post-meta">
        <div class="blog-author-chip">
          <img
            src={data.author.avatar}
            alt={data.author.name}
            class="blog-author-avatar"
            width="40"
            height="40"
          />
          <div class="blog-author-text">
            <span class="blog-author-name">{data.author.name}</span>
            <span class="blog-author-role">{data.author.role}</span>
          </div>
        </div>

        <div class="blog-post-stats">
          <span class="blog-stat">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {formattedDate}
          </span>

          {
            data.readingTime && (
              <span class="blog-stat">
                <Clock class="w-4 h-4" />
                <span data-i18n="blog.readingTime">
                  {data.readingTime} min read
                </span>
              </span>
            )
          }

          <button class="blog-share-btn" id="share-btn" aria-label="Share post">
            <Share2 class="w-4 h-4" />
            <span data-i18n="blog.share">Share</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  {
    data.coverImage && (
      <div class="blog-cover-wrapper">
        <div class="blog-cover-inner">
          <img
            src={data.coverImage}
            alt={data.title}
            class="blog-cover-image"
            width="1200"
            height="630"
          />
          <div class="blog-cover-overlay" />
        </div>
      </div>
    )
  }

  <div class="blog-content-wrapper">
    <div class="blog-prose-container">
      <slot />
    </div>

    <footer class="blog-post-footer">
      <div class="blog-footer-author">
        <img
          src={data.author.avatar}
          alt={data.author.name}
          class="blog-footer-avatar"
          width="72"
          height="72"
        />
        <div class="blog-footer-author-info">
          <p class="blog-footer-written-by" data-i18n="blog.writtenBy">
            Written by
          </p>
          <h3 class="blog-footer-author-name">{data.author.name}</h3>
          <p class="blog-footer-author-role">{data.author.role}</p>
          {
            data.author.social && (
              <a
                href={data.author.social}
                target="_blank"
                rel="noopener noreferrer"
                class="blog-footer-social"
              >
                GitHub →
              </a>
            )
          }
        </div>
      </div>

      <div class="blog-footer-tags">
        <p class="blog-footer-tags-label" data-i18n="blog.topics">Topics</p>
        <div class="blog-footer-tags-list">
          {
            data.tags.map((tag: string) => (
              <span class="blog-footer-tag">{tag}</span>
            ))
          }
        </div>
      </div>

      <div class="blog-footer-cta">
        <a href="/blog" class="blog-footer-back-btn">
          <ArrowLeft class="w-4 h-4" />
          <span data-i18n="blog.backToList">Back to Blog</span>
        </a>
        <button class="blog-scroll-top-btn" id="scroll-top-btn">
          <ArrowUp class="w-4 h-4" />
          <span data-i18n="blog.backToTop">Back to top</span>
        </button>
      </div>
    </footer>
  </div>
</article>

<style>
  .blog-post-wrapper {
    min-height: 100vh;
    padding-top: 80px;
  }

  .blog-post-header {
    background: linear-gradient(
      to bottom,
      var(--surface-secondary),
      var(--surface-primary)
    );
    border-bottom: 1px solid var(--border-primary);
    padding: 3rem 0 2.5rem;
  }

  .blog-post-header-inner {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blog-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    transition: color 0.2s;
    width: fit-content;
  }

  .blog-back-link:hover {
    color: var(--accent-color);
  }

  .blog-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blog-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--accent-color);
  }

  .blog-post-title {
    font-family: "Outfit", sans-serif;
    font-size: clamp(1.875rem, 4vw, 2.875rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-heading);
    letter-spacing: -0.02em;
  }

  .blog-post-summary {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-body);
    font-family: "Lora", serif;
    font-style: italic;
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-primary);
  }

  .blog-author-chip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .blog-author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    object-fit: cover;
    border: 2px solid var(--accent-color);
  }

  .blog-author-text {
    display: flex;
    flex-direction: column;
  }

  .blog-author-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  .blog-author-role {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .blog-post-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .blog-stat {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .blog-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
    background: var(--accent-soft);
    border: 1px solid var(--accent-color);
    border-radius: 9999px;
    padding: 0.375rem 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .blog-share-btn:hover {
    background: var(--accent-color);
    color: var(--surface-primary);
  }

  .blog-cover-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .blog-cover-inner {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--border-primary);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
    aspect-ratio: 16/9;
  }

  .blog-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent 60%);
  }

  .blog-content-wrapper {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .blog-prose-container {
    padding: 2rem 0;
    font-family: "Inter", sans-serif;
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text-body);
  }

  .blog-prose-container :global(h2) {
    font-family: "Outfit", sans-serif;
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .blog-prose-container :global(h3) {
    font-family: "Outfit", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 2rem 0 0.75rem;
  }

  .blog-prose-container :global(p) {
    margin-bottom: 1.5rem;
  }

  .blog-prose-container :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-color: var(--accent-color);
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .blog-prose-container :global(a:hover) {
    color: var(--accent-color);
  }

  .blog-prose-container :global(strong) {
    font-weight: 700;
    color: var(--text-heading);
  }

  .blog-prose-container :global(em) {
    font-style: italic;
    color: var(--text-muted);
  }

  .blog-prose-container :global(ul),
  .blog-prose-container :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-prose-container :global(li) {
    color: var(--text-body);
  }

  .blog-prose-container :global(ul li) {
    list-style: disc;
  }

  .blog-prose-container :global(ol li) {
    list-style: decimal;
  }

  .blog-prose-container :global(blockquote) {
    border-left: 3px solid var(--accent-color);
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    background: var(--accent-soft);
    border-radius: 0 0.75rem 0.75rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .blog-prose-container :global(pre) {
    border-radius: 0.875rem;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.75rem 0;
    background: var(--surface-tertiary);
    border: 1px solid var(--border-primary);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .blog-prose-container :global(code) {
    font-family: "Fira Code", "Cascadia Code", monospace;
    font-size: 0.875em;
    background: var(--surface-subtle);
    color: var(--accent-text);
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
    border: 1px solid var(--border-primary);
  }

  .blog-prose-container :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-body);
    font-size: 1em;
  }

  .blog-prose-container :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border-primary);
  }

  .blog-prose-container :global(th) {
    background: var(--surface-subtle);
    color: var(--text-heading);
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-align: left;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border-primary);
  }

  .blog-prose-container :global(td) {
    padding: 0.75rem 1rem;
    color: var(--text-body);
    border-bottom: 1px solid var(--border-primary);
  }

  .blog-prose-container :global(tr:last-child td) {
    border-bottom: none;
  }

  .blog-prose-container :global(hr) {
    border: none;
    border-top: 1px solid var(--border-primary);
    margin: 2.5rem 0;
  }

  .blog-post-footer {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-primary);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-footer-author {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--surface-secondary);
    border-radius: 1.25rem;
    border: 1px solid var(--border-primary);
  }

  .blog-footer-avatar {
    width: 72px;
    height: 72px;
    border-radius: 9999px;
    object-fit: cover;
    border: 3px solid var(--accent-color);
    flex-shrink: 0;
  }

  .blog-footer-author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .blog-footer-written-by {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .blog-footer-author-name {
    font-family: "Outfit", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
  }

  .blog-footer-author-role {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .blog-footer-social {
    display: inline-flex;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-text);
    transition: color 0.2s;
  }

  .blog-footer-social:hover {
    color: var(--accent-color);
  }

  .blog-footer-tags {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blog-footer-tags-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .blog-footer-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blog-footer-tag {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid var(--border-primary);
    transition: all 0.2s;
  }

  .blog-footer-tag:hover {
    background: var(--accent-soft);
    color: var(--accent-text);
    border-color: var(--accent-color);
  }

  .blog-footer-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
  }

  .blog-footer-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--surface-subtle);
    color: var(--text-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--border-primary);
    transition: all 0.2s;
  }

  .blog-footer-back-btn:hover {
    background: var(--accent-soft);
    color: var(--accent-text);
    border-color: var(--accent-color);
  }

  .blog-scroll-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--surface-subtle);
    color: var(--text-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--border-primary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .blog-scroll-top-btn:hover {
    background: var(--button-dark-bg);
    color: var(--button-dark-text);
    border-color: var(--button-dark-bg);
  }

  @media (max-width: 640px) {
    .blog-post-header {
      padding: 2rem 0 1.5rem;
    }

    .blog-post-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .blog-footer-author {
      flex-direction: column;
    }

    .blog-footer-cta {
      justify-content: center;
    }
  }
</style>

<script>
  document.getElementById("share-btn")?.addEventListener("click", async () => {
    const url = window.location.href;
    const title = document.title;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch (_) {}
    } else {
      try {
        await navigator.clipboard.writeText(url);
        const btn = document.getElementById("share-btn");
        if (btn) {
          const original = btn.innerHTML;
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!`;
          setTimeout(() => {
            btn.innerHTML = original;
          }, 2000);
        }
      } catch (_) {}
    }
  });

  document.getElementById("scroll-top-btn")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
