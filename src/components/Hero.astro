---
import { translations } from "../i18n/translations.js";
import {
  ArrowRight,
  ExternalLink,
  MousePointer2,
  Smartphone,
} from "lucide-astro";
const t = (translations as any).en;
---

<section
  id="hero"
  class="relative min-h-dvh flex items-center justify-center pt-32 pb-20 overflow-hidden bg-white"
>
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div
      class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] bg-rose-accent/20 rounded-full blur-[120px] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-[-10%] right-[-10%] w-[40vw] h-[40vw] bg-accent/20 rounded-full blur-[100px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_2px_2px,rgba(0,0,0,0.03)_1px,transparent_0)] bg-size-[32px_32px]"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
    <div class="flex flex-col items-center">
      <div class="mb-10 opacity-0 hero-v3-badge">
        <div
          class="px-5 py-2 bg-white/40 backdrop-blur-xl border border-black/5 rounded-2xl shadow-sm flex items-center gap-3"
        >
          <div class="flex -space-x-2">
            <div
              class="w-6 h-6 rounded-full bg-rose-accent border-2 border-white"
            >
            </div>
            <div class="w-6 h-6 rounded-full bg-accent border-2 border-white">
            </div>
          </div>
          <span
            class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400"
            data-i18n="hero.badge">{t.hero.badge}</span
          >
        </div>
      </div>

      <div class="text-center mb-16 relative">
        <h1
          class="text-6xl sm:text-8xl lg:text-[10rem] font-[Outfit] font-black leading-none tracking-tight text-gray-900 opacity-0 hero-v3-title"
          data-i18n="hero.title"
          set:html={t.hero.title}
        />

        <div
          class="absolute -top-10 -left-10 md:-top-20 md:-left-20 opacity-0 hero-v3-float-1"
        >
          <div
            class="p-4 bg-white rounded-3xl shadow-2xl border border-black/5 -rotate-12 backdrop-blur-md"
          >
            <MousePointer2 class="w-8 h-8 md:w-12 md:h-12 text-rose-accent" />
          </div>
        </div>

        <div
          class="absolute -bottom-10 -right-10 md:-bottom-20 md:-right-20 opacity-0 hero-v3-float-2"
        >
          <div
            class="p-4 bg-white rounded-3xl shadow-2xl border border-black/5 rotate-12 backdrop-blur-md"
          >
            <Smartphone class="w-8 h-8 md:w-12 md:h-12 text-accent" />
          </div>
        </div>
      </div>

      <div class="max-w-3xl text-center space-y-10">
        <div class="flex flex-wrap justify-center gap-4 opacity-0 hero-v3-tags">
          <span
            class="px-4 py-1.5 bg-gray-50 text-gray-500 rounded-full text-xs font-bold border border-black/5 uppercase tracking-wider"
            >Full Stack Engineer</span
          >
          <span
            class="px-4 py-1.5 bg-gray-50 text-gray-500 rounded-full text-xs font-bold border border-black/5 uppercase tracking-wider"
            >Product Designer</span
          >
          <span
            class="px-4 py-1.5 bg-gray-50 text-gray-500 rounded-full text-xs font-bold border border-black/5 uppercase tracking-wider"
            >Creative Developer</span
          >
        </div>

        <p
          class="text-xl md:text-3xl text-gray-400 leading-tight font-light opacity-0 hero-v3-role"
          data-i18n="hero.role"
        >
          {t.hero.role}
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-8 pt-6 opacity-0 hero-v3-actions"
        >
          <a
            href="#projects"
            class="group flex items-center gap-4 text-gray-900"
          >
            <div
              class="w-16 h-16 rounded-full bg-gray-900 flex items-center justify-center transition-transform duration-500 group-hover:scale-110 group-hover:bg-rose-accent"
            >
              <ArrowRight
                class="w-6 h-6 text-white group-hover:text-gray-900 transition-colors"
              />
            </div>
            <div class="text-left">
              <p
                class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"
                data-i18n="hero.ctaSub"
              >
                {t.hero.ctaSub}
              </p>
              <p
                class="font-bold uppercase tracking-widest text-sm"
                data-i18n="hero.cta"
              >
                {t.hero.cta}
              </p>
            </div>
          </a>

          <div class="w-px h-12 bg-gray-100 hidden sm:block"></div>

          <a
            href="https://dot-studio.site"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 text-gray-900"
          >
            <div
              class="w-16 h-16 rounded-full bg-white border-2 border-black/5 flex items-center justify-center transition-transform duration-500 group-hover:scale-110 group-hover:border-dot-purple"
            >
              <ExternalLink
                class="w-6 h-6 text-gray-400 group-hover:text-dot-purple transition-colors"
              />
            </div>
            <div class="text-left">
              <p
                class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"
                data-i18n="hero.ctaStudioSub"
              >
                {t.hero.ctaStudioSub}
              </p>
              <p
                class="font-bold uppercase tracking-widest text-sm"
                data-i18n="hero.ctaStudio"
              >
                {t.hero.ctaStudio}
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-10 left-6 hidden sm:flex items-center gap-4 hero-v3-scroll opacity-0"
  >
    <div
      class="w-px h-12 bg-linear-to-b from-gray-200 to-transparent relative overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 w-full h-1/3 bg-rose-accent animate-mouse-scroll"
      >
      </div>
    </div>
    <span
      class="text-[9px] font-bold text-gray-400 uppercase tracking-[0.3em] [writing-mode:vertical-rl]"
      >Scroll</span
    >
  </div>
</section>

<style>
  @keyframes mouse-scroll {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translateY(12px);
      opacity: 0;
    }
  }
  .animate-mouse-scroll {
    animation: mouse-scroll 2s ease-in-out infinite;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // @ts-ignore
    if (typeof gsap !== "undefined") {
      // @ts-ignore
      const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

      tl.to(".hero-v3-badge", { opacity: 1, y: 0, duration: 1 })
        .to(".hero-v3-title", { opacity: 1, y: 0, duration: 1.2 }, "-=0.8")
        .to(
          ".hero-v3-float-1",
          { opacity: 1, x: 0, y: 0, duration: 1.5, rotate: -12 },
          "-=1",
        )
        .to(
          ".hero-v3-float-2",
          { opacity: 1, x: 0, y: 0, duration: 1.5, rotate: 12 },
          "-=1.3",
        )
        .to(".hero-v3-tags", { opacity: 1, y: 0, duration: 1 }, "-=1")
        .to(".hero-v3-role", { opacity: 1, y: 0, duration: 1 }, "-=0.9")
        .to(".hero-v3-actions", { opacity: 1, y: 0, duration: 1 }, "-=0.9")
        .to(".hero-v3-scroll", { opacity: 1, duration: 1 }, "-=0.5");

      document.addEventListener("mousemove", (e) => {
        const x = e.clientX / window.innerWidth - 0.5;
        const y = e.clientY / window.innerHeight - 0.5;
        // @ts-ignore
        gsap.to(".hero-v3-float-1", {
          x: x * 60,
          y: y * 60,
          duration: 2,
          ease: "power2.out",
        });
        // @ts-ignore
        gsap.to(".hero-v3-float-2", {
          x: x * -80,
          y: y * -80,
          duration: 2.5,
          ease: "power2.out",
        });
        // @ts-ignore
        gsap.to(".hero-v3-title", {
          x: x * 20,
          y: y * 10,
          duration: 1.5,
          ease: "power3.out",
        });
      });
    }
  });
</script>
