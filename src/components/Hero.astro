---
import { translations } from "../i18n/translations.js";
import { ArrowUpRight, Globe } from "lucide-astro";
const t = (translations as any).en;
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col bg-white select-none overflow-hidden pt-32 pb-12 px-6 sm:px-12"
>
  <!-- Minimalist Framework Lines -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-0 left-1/2 w-px h-full bg-gray-100/60 hidden lg:block"
    >
    </div>
    <div
      class="absolute top-[40%] left-0 w-full h-px bg-gray-100/60 hidden lg:block"
    >
    </div>
  </div>

  <!-- Background Name Stencil (Subtle) -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center pointer-events-none opacity-[0.03]"
  >
    <span
      class="text-[30vw] font-[Outfit] font-black leading-none uppercase tracking-[-0.05em]"
      >FRAN</span
    >
  </div>

  <div class="max-w-7xl mx-auto w-full flex-1 flex flex-col relative z-10">
    <div class="grid lg:grid-cols-2 gap-0 flex-1 border border-gray-100">
      <!-- Left Panel: The Greeting & Identity -->
      <div
        class="p-8 sm:p-12 lg:p-20 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-gray-100"
      >
        <div class="space-y-6">
          <div class="overflow-hidden">
            <div class="hero-reveal flex items-center gap-3">
              <span class="w-10 h-px bg-accent"></span>
              <span
                class="text-[10px] font-black uppercase tracking-[0.4em] text-accent-text"
                data-i18n="hero.badge">{t.hero.badge}</span
              >
            </div>
          </div>

          <div class="space-y-2">
            <div class="overflow-hidden">
              <h1
                class="hero-reveal text-[3.5rem] sm:text-[5rem] lg:text-[6rem] font-[Outfit] font-black leading-[0.9] tracking-tight text-gray-950"
              >
                <span data-i18n="hero.greeting">{t.hero.greeting}</span><br />
                <span
                  class="text-accent underline decoration-gray-100 decoration-8 underline-offset-8"
                  data-i18n="hero.name">{t.hero.name}</span
                >
              </h1>
            </div>
          </div>
        </div>

        <div class="hidden lg:block overflow-hidden">
          <div
            class="hero-reveal flex items-center gap-4 text-[9px] font-black uppercase tracking-[0.4em] text-gray-300"
          >
            <span>Buenos Aires / Argentina</span>
            <span class="w-1 h-1 rounded-full bg-gray-200"></span>
            <span>2026 Portfolio</span>
          </div>
        </div>
      </div>

      <!-- Right Panel: The Mission & CTAs -->
      <div class="p-8 sm:p-12 lg:p-20 flex flex-col justify-end bg-gray-50/30">
        <div class="max-w-md space-y-12">
          <div class="space-y-6">
            <div class="overflow-hidden">
              <p
                class="hero-reveal text-2xl sm:text-3xl font-light text-gray-900 leading-tight"
                data-i18n="hero.role"
              >
                {t.hero.role}
              </p>
            </div>
            <div class="overflow-hidden">
              <p
                class="hero-reveal text-base sm:text-lg text-gray-400 font-light leading-relaxed"
                data-i18n="hero.description"
              >
                {t.hero.description}
              </p>
            </div>
          </div>

          <!-- Vertical CTA Stack -->
          <div class="space-y-6">
            <div class="overflow-hidden">
              <a
                href="#projects"
                class="hero-reveal group inline-flex items-center gap-6 py-4 px-8 bg-gray-950 text-white rounded-full hover:bg-accent hover:text-gray-950 transition-all duration-500 no-underline"
              >
                <span
                  class="text-xs font-black uppercase tracking-widest"
                  data-i18n="hero.cta">{t.hero.cta}</span
                >
                <ArrowUpRight
                  class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                />
              </a>
            </div>

            <div class="overflow-hidden">
              <a
                href="https://dot-studio.site"
                target="_blank"
                class="hero-reveal group inline-flex items-center gap-4 text-gray-400 hover:text-dot-green transition-colors duration-500 no-underline"
              >
                <Globe
                  class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity"
                />
                <span
                  class="text-[10px] font-black uppercase tracking-[0.3em]"
                  data-i18n="hero.ctaStudio">{t.hero.ctaStudio}</span
                >
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline({
      defaults: {
        ease: "power4.out",
        duration: 1.8,
      },
    });

    // Hide all initially
    gsap.set(".hero-reveal", { y: "150%" });

    tl.to(".hero-reveal", {
      y: "0%",
      stagger: 0.1,
    }).fromTo(
      ".bg-gray-100",
      { scaleX: 0 },
      { scaleX: 1, stagger: 0.2, duration: 1.5 },
      "-=1.5",
    );
  });
</script>

<style>
  .hero-reveal {
    will-change: transform;
  }

  /* Remove annoying selection behavior for text purely for aesthetics */
  #hero {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
