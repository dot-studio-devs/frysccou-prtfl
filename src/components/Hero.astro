---
import { translations } from "../i18n/translations.js";
import { ArrowUpRight, Globe, Code2, Layers } from "lucide-astro";
const t = (translations as any).en;
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col bg-surface select-none overflow-hidden"
>
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-px bg-accent/10"></div>
    <div
      class="absolute top-0 left-1/4 w-px h-full bg-accent/5 hidden lg:block"
    >
    </div>
    <div
      class="absolute top-0 left-2/4 w-px h-full bg-accent/5 hidden lg:block"
    >
    </div>
    <div
      class="absolute top-0 left-3/4 w-px h-full bg-accent/5 hidden lg:block"
    >
    </div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-accent/10"></div>
  </div>

  <div
    class="absolute top-0 right-0 w-1/2 h-full pointer-events-none hidden lg:block"
  >
    <div class="absolute inset-0 bg-accent/2"></div>
    <div class="absolute top-0 left-0 w-px h-full bg-accent/10"></div>
  </div>

  <div
    class="max-w-7xl mx-auto w-full flex-1 flex flex-col justify-center relative z-10 px-6 sm:px-12 py-32"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-7 space-y-10">
        <div class="overflow-hidden">
          <div class="hero-reveal flex items-center gap-3">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-accent"
                ></span>
              </span>
              <span
                class="text-[10px] font-black uppercase tracking-[0.3em] text-accent"
                data-i18n="hero.greeting">{t.hero.greeting}</span
              >
            </div>
          </div>
        </div>

        <div class="overflow-visible">
          <h1
            class="hero-reveal font-[Outfit] font-black leading-[0.9] tracking-tighter text-text-primary hero-name"
          >
            <span data-i18n="hero.name">{t.hero.name}</span><span
              class="text-accent">.</span
            >
          </h1>
        </div>

        <div class="overflow-hidden">
          <div
            class="hero-reveal inline-flex items-center gap-2 px-4 py-2 rounded-full border border-accent/30 bg-accent/5"
          >
            <Code2 class="w-3.5 h-3.5 text-accent" />
            <span
              class="text-[10px] font-black uppercase tracking-[0.25em] text-accent whitespace-nowrap"
              data-i18n="hero.role">{t.hero.role}</span
            >
          </div>
        </div>

        <div class="overflow-hidden max-w-xl">
          <p
            class="hero-reveal text-base sm:text-lg text-text-muted font-light leading-relaxed"
            data-i18n="hero.manifesto"
          >
            {t.hero.manifesto}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-start gap-4">
          <div class="overflow-hidden">
            <a
              href="#projects"
              class="hero-reveal group inline-flex items-center gap-5 py-4 px-8 bg-th-btn-dark text-th-btn-dark-text rounded-full hover:bg-accent hover:text-white transition-all duration-500 no-underline"
            >
              <span
                class="text-xs font-black uppercase tracking-widest"
                data-i18n="hero.cta">{t.hero.cta}</span
              >
              <ArrowUpRight
                class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
              />
            </a>
          </div>

          <div class="overflow-hidden">
            <a
              href="https://dot-studio.site"
              target="_blank"
              class="hero-reveal group inline-flex items-center gap-3 py-4 px-2 text-text-muted hover:text-dot-green transition-colors duration-500 no-underline"
            >
              <Globe
                class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity group-hover:text-dot-green"
              />
              <span
                class="text-[10px] font-black uppercase tracking-[0.3em]"
                data-i18n="hero.ctaStudio">{t.hero.ctaStudio}</span
              >
            </a>
          </div>
        </div>
      </div>

      <div
        class="lg:col-span-5 hidden lg:flex flex-col items-center justify-center"
      >
        <div class="hero-reveal relative w-full max-w-xs">
          <div
            class="relative border border-th-border rounded-2xl bg-surface-muted p-6 space-y-5"
          >
            <div class="flex items-center gap-3 pb-4 border-b border-th-border">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-rose-accent/60"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-accent/40"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-dot-green/50"></div>
              </div>
              <span
                class="text-[9px] font-mono text-text-muted uppercase tracking-wider"
                >status.config</span
              >
            </div>
            <div class="space-y-4">
              <div class="space-y-1.5">
                <div
                  class="flex items-center justify-between text-[8px] font-mono text-text-muted uppercase tracking-widest"
                >
                  <span data-i18n="hero.systemLoad">{t.hero.systemLoad}</span>
                  <span class="text-accent" data-i18n="hero.active"
                    >{t.hero.active}</span
                  >
                </div>
                <div
                  class="w-full h-1 bg-th-border/30 rounded-full overflow-hidden relative"
                >
                  <div class="hero-progress-bar h-full bg-accent w-[65%]"></div>
                </div>
              </div>
              <div class="w-full h-px bg-th-border/50"></div>
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-mono text-text-muted uppercase tracking-wider"
                  >Stack</span
                >
                <span class="text-[10px] font-mono text-accent font-bold"
                  >Full Stack</span
                >
              </div>
              <div class="w-full h-px bg-th-border"></div>
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-mono text-text-muted uppercase tracking-wider"
                  >Focus</span
                >
                <span class="text-[10px] font-mono text-text-primary font-bold"
                  >UI/UX + Arch</span
                >
              </div>
              <div class="w-full h-px bg-th-border"></div>
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-mono text-text-muted uppercase tracking-wider"
                  >Status</span
                >
                <div class="flex items-center gap-1.5">
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-dot-green animate-pulse"
                  ></span>
                  <span class="text-[10px] font-mono text-dot-green font-bold"
                    >Available</span
                  >
                </div>
              </div>
              <div class="w-full h-px bg-th-border/50"></div>
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-mono text-text-muted uppercase tracking-wider"
                  >Based in</span
                >
                <span
                  class="text-[10px] font-mono text-text-primary font-bold"
                  data-i18n="hero.location">{t.hero.location}</span
                >
              </div>
              <div class="w-full h-px bg-th-border/50"></div>
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-mono text-text-muted uppercase tracking-wider"
                  >Version</span
                >
                <span
                  class="text-[10px] font-mono text-text-primary font-bold opacity-50"
                  >v4.0.2-stable</span
                >
              </div>
            </div>
          </div>

          <!-- New Session Context Card -->
          <div class="hero-reveal mt-4 relative w-full group/status">
            <div
              class="border border-th-border rounded-2xl bg-surface/40 backdrop-blur-xl p-4 flex items-center justify-between hover:border-accent/40 transition-colors duration-500"
            >
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center overflow-hidden relative group-hover/status:scale-105 transition-transform duration-500"
                >
                  <div
                    class="absolute inset-0 bg-linear-to-tr from-accent/20 to-transparent opacity-0 group-hover/status:opacity-100 transition-opacity"
                  >
                  </div>
                  <img
                    src="/ysc-transparente.png"
                    alt="Logo"
                    class="w-7 h-7 object-contain opacity-80 group-hover/status:opacity-100"
                  />
                </div>
                <div class="flex flex-col">
                  <div class="flex items-center gap-2 text-nowrap">
                    <span
                      class="text-[9px] font-mono text-accent uppercase tracking-widest font-bold"
                      data-i18n="hero.identity">{t.hero.identity}</span
                    >
                    <span class="w-1 h-1 rounded-full bg-accent/40"></span>
                    <span class="text-[8px] font-mono text-text-muted"
                      >v4.0.2</span
                    >
                  </div>
                  <span
                    class="text-[10px] font-mono text-text-muted group-hover/status:text-text-primary transition-colors"
                    data-i18n="hero.session">{t.hero.session}</span
                  >
                </div>
              </div>
              <div class="flex flex-col items-end gap-1">
                <div
                  class="px-1.5 py-0.5 rounded bg-dot-green/10 border border-dot-green/20 flex items-center gap-1"
                >
                  <span class="w-1 h-1 rounded-full bg-dot-green animate-pulse"
                  ></span>
                  <span
                    class="text-[7px] font-mono text-dot-green font-bold italic tracking-tighter uppercase"
                    >Live</span
                  >
                </div>
                <span
                  class="text-[7px] font-mono text-text-muted/50 uppercase tracking-tighter"
                  data-i18n="hero.encrypted">{t.hero.encrypted}</span
                >
              </div>
            </div>
          </div>

          <div
            class="absolute -bottom-3 -right-3 border border-th-border rounded-xl bg-surface p-3 shadow-lg group-hover:scale-110 transition-transform duration-500"
          >
            <Layers class="w-4 h-4 text-accent" />
          </div>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-12 left-6 sm:left-12 hidden lg:flex items-center gap-6 text-[9px] font-black uppercase tracking-[0.4em] text-text-muted"
    >
      <div class="flex items-center gap-2">
        <span class="w-1 h-1 rounded-full bg-accent"></span>
        <span class="hero-reveal" data-i18n="hero.location"
          >{t.hero.location}</span
        >
      </div>
      <span class="hero-reveal w-1 h-1 rounded-full bg-th-border-muted/50"
      ></span>
      <div class="flex items-center gap-2">
        <span class="text-accent/50 italic opacity-50">#</span>
        <span class="hero-reveal" data-i18n="hero.kernel">{t.hero.kernel}</span>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline({
      defaults: {
        ease: "power4.out",
        duration: 1.8,
      },
    });

    gsap.set(".hero-reveal", { y: "150%" });

    tl.to(".hero-reveal", {
      y: "0%",
      stagger: 0.12,
    });
  });
</script>

<style>
  .hero-reveal {
    will-change: transform;
  }

  #hero {
    -webkit-user-select: none;
    user-select: none;
  }

  .hero-name {
    font-size: clamp(3.5rem, 8vw, 9.5rem);
  }

  .hero-progress-bar {
    position: relative;
    overflow: hidden;
  }

  .hero-progress-bar::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
</style>
