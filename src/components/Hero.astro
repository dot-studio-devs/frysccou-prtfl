---
import { translations } from "../i18n/translations.js";
import { ArrowUpRight, Globe } from "lucide-astro";
const t = (translations as any).en;
---

<section
  id="hero"
  class="relative min-h-dvh flex flex-col bg-white select-none overflow-hidden"
>
  <div
    class="absolute top-[-10%] right-[10%] w-125 h-125 rounded-full bg-accent/15 blur-[150px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-[10%] left-[-5%] w-100 h-100 rounded-full bg-rose-soft/50 blur-[120px] pointer-events-none"
  >
  </div>

  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center pointer-events-none opacity-[0.02]"
  >
    <span
      class="text-[30vw] font-[Outfit] font-black leading-none uppercase tracking-[-0.05em]"
      >FRAN</span
    >
  </div>

  <div
    class="max-w-7xl mx-auto w-full flex-1 flex flex-col justify-center relative z-10 px-6 sm:px-12 py-32"
  >
    <div class="space-y-12 sm:space-y-16">
      <div class="overflow-hidden">
        <div class="hero-reveal flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span
            class="text-[10px] font-black uppercase tracking-[0.3em] text-gray-400"
            data-i18n="hero.greeting">{t.hero.greeting}</span
          >
        </div>
      </div>

      <div class="overflow-hidden">
        <h1
          class="hero-reveal font-[Outfit] font-black leading-[0.85] tracking-tighter text-gray-950 hero-name"
        >
          <span data-i18n="hero.name">{t.hero.name}</span><span
            class="text-accent">.</span
          >
        </h1>
      </div>

      <div
        class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-10 max-w-4xl"
      >
        <div class="overflow-hidden shrink-0">
          <div
            class="hero-reveal inline-flex items-center px-5 py-2.5 rounded-full bg-accent text-gray-950"
          >
            <span
              class="text-[10px] font-black uppercase tracking-[0.25em] whitespace-nowrap"
              data-i18n="hero.role">{t.hero.role}</span
            >
          </div>
        </div>
        <div class="overflow-hidden">
          <p
            class="hero-reveal text-base sm:text-lg lg:text-xl text-gray-400 font-light leading-relaxed"
            data-i18n="hero.manifesto"
          >
            {t.hero.manifesto}
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-start gap-5">
        <div class="overflow-hidden">
          <a
            href="#projects"
            class="hero-reveal group inline-flex items-center gap-6 py-4 px-8 bg-gray-950 text-white rounded-full hover:bg-accent hover:text-gray-950 transition-all duration-500 no-underline"
          >
            <span
              class="text-xs font-black uppercase tracking-widest"
              data-i18n="hero.cta">{t.hero.cta}</span
            >
            <ArrowUpRight
              class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
            />
          </a>
        </div>

        <div class="overflow-hidden">
          <a
            href="https://dot-studio.site"
            target="_blank"
            class="hero-reveal group inline-flex items-center gap-3 py-4 text-gray-400 hover:text-accent transition-colors duration-500 no-underline"
          >
            <Globe
              class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity"
            />
            <span
              class="text-[10px] font-black uppercase tracking-[0.3em]"
              data-i18n="hero.ctaStudio">{t.hero.ctaStudio}</span
            >
          </a>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-12 left-6 sm:left-12 hidden lg:flex items-center gap-4 text-[9px] font-black uppercase tracking-[0.4em] text-gray-300"
    >
      <span class="hero-reveal" data-i18n="hero.location"
        >{t.hero.location}</span
      >
      <span class="hero-reveal w-1 h-1 rounded-full bg-gray-300"></span>
      <span class="hero-reveal">2026</span>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline({
      defaults: {
        ease: "power4.out",
        duration: 1.8,
      },
    });

    gsap.set(".hero-reveal", { y: "150%" });

    tl.to(".hero-reveal", {
      y: "0%",
      stagger: 0.12,
    });
  });
</script>

<style>
  .hero-reveal {
    will-change: transform;
  }

  #hero {
    -webkit-user-select: none;
    user-select: none;
  }

  .hero-name {
    font-size: clamp(4rem, 12vw, 11rem);
  }
</style>
