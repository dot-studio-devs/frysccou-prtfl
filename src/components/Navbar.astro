---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] flex justify-center pointer-events-none"
>
  <div
    id="nav-container"
    class="w-full px-8 py-5 flex items-center justify-between pointer-events-auto transition-all duration-500 border-b border-white/5"
  >
    <a href="/" class="flex items-center group" aria-label="YSC Home">
      <img
        src="/brand/android-chrome-192x192.png"
        alt="YSC"
        class="h-7 w-auto transition-opacity duration-300 group-hover:opacity-70"
      />
    </a>

    <div class="hidden md:flex items-center gap-10">
      {
        navLinks.map((link) => {
          const isActive =
            link.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                "nav-link text-[11px] font-bold uppercase tracking-[0.2em] transition-colors duration-300",
                isActive ? "text-accent-text" : "text-white/30 hover:text-white",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>

    <div class="flex items-center gap-3">
      <button
        id="lang-toggle"
        class="hidden md:flex px-3 py-1.5 rounded border border-accent/20 text-[10px] font-bold uppercase tracking-widest text-accent-text/60 hover:text-accent-text hover:border-accent/50 transition-all duration-300"
        aria-label="Toggle language"
      >
        <span id="lang-label">EN</span>
      </button>

      <button
        id="mobile-menu-btn"
        aria-label="Open Menu"
        class="md:hidden flex flex-col items-center justify-center gap-1.5 w-10 h-10"
      >
        <span class="w-5 h-px bg-white transition-all duration-300 origin-center" id="bar1"></span>
        <span class="w-5 h-px bg-white transition-all duration-300" id="bar2"></span>
        <span class="w-3 h-px bg-white/50 transition-all duration-300 self-start" id="bar3"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-overlay"
    class="fixed inset-0 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  >
  </div>

  <div
    id="mobile-drawer"
    class="fixed top-0 right-0 h-full w-72 bg-[#050505] border-l border-white/5 translate-x-full transition-transform duration-300 md:hidden flex flex-col pointer-events-auto"
  >
    <div class="p-8 flex items-center justify-between border-b border-white/5">
      <img src="/brand/android-chrome-192x192.png" alt="YSC" class="h-6 w-auto opacity-60" />
      <button
        id="close-drawer"
        aria-label="Close Menu"
        class="w-8 h-8 flex items-center justify-center text-white/30 hover:text-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    <div class="flex-1 p-8 flex flex-col gap-2">
      {
        navLinks.map((link) => {
          const isActive =
            link.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                "py-4 text-lg font-[Outfit] font-bold tracking-tight border-b border-white/5 transition-colors duration-200",
                isActive ? "text-accent-text" : "text-white/30 hover:text-white",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>

    <div class="p-8 border-t border-white/5">
      <button
        id="mobile-lang-toggle"
        class="w-full py-3 rounded border border-white/10 text-[10px] font-bold uppercase tracking-widest text-white/30 hover:text-white hover:border-white/30 transition-all duration-300"
      >
        <span id="mobile-lang-label">EN</span> / <span id="mobile-lang-other">ES</span>
      </button>
    </div>
  </div>
</nav>

<script>
  import { applyLanguage, getStoredLang } from "../lib/i18n-runtime";

  const LANGS = ["en", "es"] as const;
  type Lang = typeof LANGS[number];

  function getCurrentLang(): Lang {
    const stored = getStoredLang() as Lang;
    return LANGS.includes(stored) ? stored : "en";
  }

  function setLang(lang: Lang) {
    document.cookie = `selected-lang=${lang};path=/;SameSite=Lax;max-age=31536000`;
    applyLanguage(lang);
    updateLangUI(lang);
  }

  function updateLangUI(lang: Lang) {
    const other: Lang = lang === "en" ? "es" : "en";
    const label = document.getElementById("lang-label");
    const mobileLabel = document.getElementById("mobile-lang-label");
    const mobileOther = document.getElementById("mobile-lang-other");
    if (label) label.textContent = lang.toUpperCase();
    if (mobileLabel) mobileLabel.textContent = lang.toUpperCase();
    if (mobileOther) mobileOther.textContent = other.toUpperCase();
  }

  document.addEventListener("DOMContentLoaded", () => {
    const currentLang = getCurrentLang();
    applyLanguage(currentLang);
    updateLangUI(currentLang);

    document.getElementById("lang-toggle")?.addEventListener("click", () => {
      const current = getCurrentLang();
      setLang(current === "en" ? "es" : "en");
    });

    document.getElementById("mobile-lang-toggle")?.addEventListener("click", () => {
      const current = getCurrentLang();
      setLang(current === "en" ? "es" : "en");
    });
  });

  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const closeDrawerBtn = document.getElementById("close-drawer");
  const mobileDrawer = document.getElementById("mobile-drawer");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const bar1 = document.getElementById("bar1");
  const bar2 = document.getElementById("bar2");
  const bar3 = document.getElementById("bar3");

  let isOpen = false;

  function openDrawer() {
    isOpen = true;
    mobileDrawer?.classList.remove("translate-x-full");
    mobileDrawer?.classList.add("translate-x-0");
    mobileOverlay?.classList.remove("opacity-0", "pointer-events-none");
    mobileOverlay?.classList.add("opacity-100");
    document.body.style.overflow = "hidden";
    if (bar1) bar1.style.transform = "rotate(45deg) translateY(6px)";
    if (bar2) bar2.style.opacity = "0";
    if (bar3) { bar3.style.transform = "rotate(-45deg) translateY(-6px)"; bar3.style.width = "1.25rem"; bar3.style.opacity = "1"; }
  }

  function closeDrawer() {
    isOpen = false;
    mobileDrawer?.classList.add("translate-x-full");
    mobileDrawer?.classList.remove("translate-x-0");
    mobileOverlay?.classList.add("opacity-0", "pointer-events-none");
    mobileOverlay?.classList.remove("opacity-100");
    document.body.style.overflow = "";
    if (bar1) bar1.style.transform = "none";
    if (bar2) bar2.style.opacity = "1";
    if (bar3) { bar3.style.transform = "none"; bar3.style.width = "0.75rem"; bar3.style.opacity = "0.5"; }
  }

  mobileMenuBtn?.addEventListener("click", () => isOpen ? closeDrawer() : openDrawer());
  closeDrawerBtn?.addEventListener("click", closeDrawer);
  mobileOverlay?.addEventListener("click", closeDrawer);

  window.addEventListener("scroll", () => {
    const nav = document.getElementById("main-nav");
    const container = document.getElementById("nav-container");
    const isScrolled = window.scrollY > 80;

    if (isScrolled) {
      nav?.classList.add("top-4", "px-6");
      container?.classList.add(
        "max-w-4xl",
        "rounded-2xl",
        "bg-black/80",
        "backdrop-blur-xl",
        "border",
        "border-white/8",
        "shadow-2xl",
        "py-3",
        "px-6",
      );
      container?.classList.remove("py-5", "border-b", "border-white/5");
    } else {
      nav?.classList.remove("top-4", "px-6");
      container?.classList.remove(
        "max-w-4xl",
        "rounded-2xl",
        "bg-black/80",
        "backdrop-blur-xl",
        "border",
        "border-white/8",
        "shadow-2xl",
        "py-3",
        "px-6",
      );
      container?.classList.add("py-5", "border-b", "border-white/5");
    }
  });
</script>
