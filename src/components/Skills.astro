---
import { translations } from "../i18n/translations.js";
import { skills } from "../i18n/data.js";
import {
  Code,
  Monitor,
  Server,
  Layers,
  Palette,
  Database,
  Terminal,
} from "lucide-astro";
const t = translations.en;

const skillCategories = [
  { id: "languages", icon: Code },
  { id: "frontend", icon: Monitor },
  { id: "backend", icon: Server },
  { id: "fullstack", icon: Layers },
  { id: "design", icon: Palette },
  { id: "databases", icon: Database },
  { id: "devops", icon: Terminal },
];
---

<section
  id="skills"
  class="py-44 bg-surface border-t border-th-border relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="skills-header opacity-0 translate-y-10 mb-24">
      <div class="space-y-10">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px bg-accent"></span>
          <span
            class="text-[10px] font-black uppercase tracking-[0.4em] text-text-muted"
            >Toolkit</span
          >
        </div>

        <div class="space-y-6">
          <h2
            class="text-6xl md:text-8xl font-[Outfit] font-black text-text-primary leading-[0.9] tracking-tighter"
            data-i18n="skills.title"
          >
            {t.skills.title}
          </h2>
          <p
            class="text-xl text-text-muted font-light leading-relaxed max-w-xl"
            data-i18n="skills.subtitle"
          >
            {t.skills.subtitle}
          </p>
        </div>
      </div>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
      {
        skillCategories.map((cat) => (
          <div class="skill-category opacity-0 translate-y-10 bg-surface rounded-3xl p-6 border border-th-border hover:border-accent transition-all duration-500 hover:shadow-xl hover:shadow-accent-soft/20 flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-10 h-10 rounded-xl bg-surface-muted flex items-center justify-center text-text-primary border border-th-border">
                <cat.icon class="w-5 h-5" />
              </div>
              <h3
                class="text-sm font-bold text-text-primary uppercase tracking-wider"
                data-i18n={`skills.${cat.id}`}
              >
                {t.skills[cat.id as keyof typeof t.skills]}
              </h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {(skills as any)[cat.id].map((skill: any) => (
                <span class="skill-tag px-3 py-1.5 bg-surface-muted rounded-xl text-xs font-medium text-text-secondary border border-th-border hover:border-accent/30 hover:bg-accent-soft/30 transition-all duration-300">
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.to(".skills-header", {
      scrollTrigger: {
        trigger: "#skills",
        start: "top 85%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power3.out",
    });

    gsap.to(".skill-category", {
      scrollTrigger: {
        trigger: "#skills",
        start: "top 75%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power3.out",
    });
  });
</script>
