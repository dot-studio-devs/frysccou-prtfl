---
import { translations } from "../i18n/translations.js";
import { skills } from "../i18n/data.js";
import { Code, Monitor, Server, Layers, Palette, Database, Terminal, Smartphone } from "lucide-astro";

const t = translations.en;

const skillCategories = [
  { id: "languages", icon: Code },
  { id: "frontend", icon: Monitor },
  { id: "backend", icon: Server },
  { id: "fullstack", icon: Layers },
  { id: "mobile", icon: Smartphone },
  { id: "design", icon: Palette },
  { id: "databases", icon: Database },
  { id: "devops", icon: Terminal },
];
---

<section
  id="skills"
  class="section-animate py-32 border-t border-white/5 relative"
>
  <div class="max-w-7xl mx-auto px-8 sm:px-12">

    <div class="mb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-accent"></span>
        <span class="text-[10px] font-black uppercase tracking-[0.4em] text-accent/60">Toolkit</span>
      </div>
      <h2
        class="text-5xl md:text-7xl font-[Outfit] font-black text-white leading-[0.9] tracking-tighter"
        data-i18n="skills.title"
      >
        {t.skills.title}
      </h2>
      <p
        class="text-white/40 text-lg font-light leading-relaxed max-w-xl mt-4"
        data-i18n="skills.subtitle"
      >
        {t.skills.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      {skillCategories.map((cat) => (
        <div class="group bg-white/[0.02] rounded-2xl p-5 border border-white/6 hover:border-accent/25 hover:bg-accent/[0.04] transition-all duration-400 flex flex-col">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-8 rounded-xl bg-white/5 border border-white/8 flex items-center justify-center group-hover:border-accent/25 group-hover:bg-accent/10 transition-all duration-400">
              <cat.icon class="w-4 h-4 text-white/40 group-hover:text-accent-text transition-colors duration-400" />
            </div>
            <h3
              class="text-xs font-bold text-white/50 uppercase tracking-wider group-hover:text-white/70 transition-colors"
              data-i18n={`skills.${cat.id}`}
            >
              {t.skills[cat.id as keyof typeof t.skills]}
            </h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {(skills as any)[cat.id].map((skill: any) => (
              <span class="px-2.5 py-1 bg-white/[0.04] rounded-lg text-[11px] font-medium text-white/40 border border-white/6 group-hover:border-accent/15 group-hover:text-white/60 transition-all duration-300">
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
