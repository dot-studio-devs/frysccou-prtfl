---
import { translations } from "../i18n/translations.js";
import { hobbies } from "../i18n/data.js";
import { Plus } from "lucide-astro";
import { Image } from "astro:assets";
import me1 from "../assets/images/me.png";

const t = (translations as any).en;
---

<section id="about" class="py-44 bg-surface relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Top Decorative Line -->
    <div class="h-px w-full bg-black/3 mb-24 relative">
      <div
        class="absolute left-0 top-1/2 -translate-y-1/2 w-12 h-0.5 bg-accent"
      >
      </div>
    </div>

    <div class="grid lg:grid-cols-[1.2fr,0.8fr] gap-32 items-start">
      <!-- Content Side -->
      <div class="space-y-24 about-main">
        <div class="space-y-10">
          <div class="flex items-center gap-6 about-reveal">
            <div
              class="w-16 h-16 rounded-2xl overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.08)] border border-th-border p-1 bg-surface"
            >
              <Image
                src={me1}
                alt="Francisco"
                width={64}
                height={64}
                class="w-full h-full object-cover rounded-xl"
              />
            </div>
            <div>
              <p
                class="text-[9px] font-black uppercase tracking-[0.6em] text-accent/50 leading-none mb-2"
                data-i18n="about.title"
              >
                {t.about.title}
              </p>
              <h2
                class="text-4xl md:text-5xl font-[Outfit] font-black text-text-primary leading-none tracking-tighter"
                data-i18n="about.subtitle"
              >
                {t.about.subtitle}
              </h2>
            </div>
          </div>

          <div class="space-y-8 max-w-2xl about-reveal">
            <p
              class="text-2xl md:text-3xl text-text-secondary font-light leading-relaxed tracking-tight"
              data-i18n="about.description1"
            >
              {t.about.description1}
            </p>
            <p
              class="text-lg text-text-muted font-light leading-relaxed"
              data-i18n="about.description2"
            >
              {t.about.description2}
            </p>
          </div>
        </div>

        <!-- Hobbies Section (High-End Typographic Grid) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 about-reveal">
          {
            hobbies.map((hobby) => (
              <div class="group py-4 border-t border-th-border hover:border-accent transition-all duration-700">
                <p class="text-[9px] font-black uppercase tracking-widest text-text-muted group-hover:text-text-primary transition-colors mb-2">
                  Category
                </p>
                <span
                  class="text-xs font-black uppercase tracking-widest text-text-muted group-hover:text-accent transition-colors"
                  data-i18n={`hobbies.${hobby.key}`}
                >
                  {t.hobbies[hobby.key as keyof typeof t.hobbies]}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Sidebar: Conceptual & Structured -->
      <div class="lg:pt-4 space-y-20 about-sidebar">
        <div class="space-y-12 about-reveal">
          <div class="relative pl-10 border-l border-accent/20">
            <Plus class="absolute -left-2.5 top-0 w-5 h-5 text-accent" />
            <p
              class="text-[10px] font-black uppercase tracking-widest text-text-muted mb-4"
            >
              Core Philosophy
            </p>
            <p
              class="text-xl text-text-primary font-light italic leading-snug"
              data-i18n="about.funFact1"
            >
              {t.about.funFact1}
            </p>
          </div>

          <div class="relative pl-10 border-l border-rose-accent/20">
            <Plus class="absolute -left-2.5 top-0 w-5 h-5 text-rose-accent" />
            <p
              class="text-[10px] font-black uppercase tracking-widest text-text-muted mb-4"
            >
              Focus State
            </p>
            <p
              class="text-xl text-text-primary font-light italic leading-snug"
              data-i18n="about.funFact2"
            >
              {t.about.funFact2}
            </p>
          </div>

          <div class="relative pl-10 border-l border-th-border">
            <Plus class="absolute -left-2.5 top-0 w-5 h-5 text-text-muted" />
            <p
              class="text-[10px] font-black uppercase tracking-widest text-text-muted mb-4"
            >
              Tech DNA
            </p>
            <p
              class="text-xl text-text-primary font-light italic leading-snug"
              data-i18n="about.funFact3"
            >
              {t.about.funFact3}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-reveal {
    opacity: 0;
    transform: translateY(20px);
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.to(".about-reveal", {
      opacity: 1,
      y: 0,
      duration: 1.4,
      stagger: 0.2,
      ease: "power4.out",
      scrollTrigger: {
        trigger: "#about",
        start: "top 80%",
      },
    });
  });
</script>
