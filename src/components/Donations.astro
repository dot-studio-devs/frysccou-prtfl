---
import { translations } from "../i18n/translations.js";
import {
  Coffee,
  ArrowUpRight,
  Copy,
  Check,
  Heart,
  ShieldCheck,
  Zap,
} from "lucide-astro";
const t = (translations as any).en;

const WALLET_ADDRESS = "0xf2f000a27e36778597f79d9fb38ce31841a3f028";
---

<section
  id="donations"
  class="py-44 bg-surface relative overflow-hidden border-t border-th-border"
>
  <!-- Background Decorative Elements -->
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2 pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-rose-accent/5 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/2 pointer-events-none"
  >
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Section Header (Independent Container) -->
    <div class="px-6 flex flex-col items-center text-center space-y-12 mb-24">
      <div
        class="donation-reveal inline-flex items-center gap-2 px-4 py-2 rounded-full border border-rose-accent/30 bg-rose-accent/5"
      >
        <Heart class="w-3.5 h-3.5 text-rose-accent fill-rose-accent/20" />
        <span
          class="text-[10px] font-black uppercase tracking-[0.3em] text-rose-accent"
          data-i18n="donations.support">Support my work</span
        >
      </div>

      <div class="space-y-6 max-w-3xl">
        <h2
          class="donation-reveal text-6xl md:text-8xl font-[Outfit] font-black text-text-primary leading-[0.9] tracking-tighter"
        >
          <span data-i18n="donations.title">{t.donations.title}</span><span
            class="text-rose-accent">.</span
          >
        </h2>
        <p
          class="donation-reveal text-xl md:text-2xl text-text-muted font-light leading-relaxed"
          data-i18n="donations.description"
        >
          {t.donations.description}
        </p>
      </div>
    </div>

    <!-- Cards Layout (Isolated Responsive Container) -->
    <div class="px-3 sm:px-6">
      <div
        class="grid md:grid-cols-2 gap-6 sm:gap-8 items-stretch max-w-5xl mx-auto"
      >
        <!-- Mercado Pago Card -->
        <div class="donation-reveal group relative">
          <div
            class="absolute -inset-0.5 bg-linear-to-r from-accent/20 to-rose-accent/20 rounded-3xl blur opacity-30 group-hover:opacity-100 transition duration-1000"
          >
          </div>
          <div
            class="relative h-full bg-surface/50 backdrop-blur-xl border border-th-border rounded-3xl p-5 sm:p-10 flex flex-col justify-between hover:border-accent/40 transition-colors duration-500 overflow-hidden"
          >
            <div class="space-y-6 sm:space-y-8">
              <div
                class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent"
              >
                <Coffee class="w-7 h-7 sm:w-8 sm:h-8" />
              </div>
              <div class="space-y-4">
                <h3
                  class="text-2xl sm:text-3xl font-[Outfit] font-bold text-text-primary"
                  data-i18n="donations.button"
                >
                  {t.donations.button}
                </h3>
                <p class="text-sm sm:text-base text-text-muted leading-relaxed">
                  A simple way to support my creative journey and keep the
                  servers running. Optimized for ARS.
                </p>
              </div>
            </div>

            <div class="mt-10 sm:mt-12 flex flex-col gap-4">
              <div
                class="flex items-center gap-3 text-[10px] sm:text-xs text-text-muted font-medium"
              >
                <ShieldCheck class="w-4 h-4 text-emerald-500" />
                Secure via Mercado Pago
              </div>
              <a
                href="https://link.mercadopago.com.ar/frysccoudev"
                target="_blank"
                rel="noopener noreferrer"
                class="group/btn relative inline-flex items-center justify-center gap-3 py-4 bg-th-btn-dark text-th-btn-dark-text rounded-2xl font-black uppercase tracking-[0.1em] sm:tracking-widest text-[10px] hover:bg-accent hover:text-white transition-all duration-500 shadow-xl shadow-black/5"
              >
                <span class="truncate">Donate via Mercado Pago</span>
                <ArrowUpRight
                  class="w-4 h-4 shrink-0 transition-transform group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1"
                />
              </a>
            </div>
          </div>
        </div>

        <!-- Crypto Card -->
        <div class="donation-reveal group relative">
          <div
            class="absolute -inset-0.5 bg-linear-to-r from-rose-accent/20 to-accent/20 rounded-3xl blur opacity-30 group-hover:opacity-100 transition duration-1000"
          >
          </div>
          <div
            class="relative h-full bg-surface/50 backdrop-blur-xl border border-th-border rounded-3xl p-5 sm:p-10 flex flex-col justify-between hover:border-rose-accent/40 transition-colors duration-500 overflow-hidden"
          >
            <div class="space-y-6 sm:space-y-8">
              <div
                class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-rose-accent/10 border border-rose-accent/20 flex items-center justify-center text-rose-accent"
              >
                <Zap class="w-7 h-7 sm:w-8 sm:h-8" />
              </div>
              <div class="space-y-3 sm:space-y-4">
                <h3
                  class="text-2xl sm:text-3xl font-[Outfit] font-bold text-text-primary"
                >
                  Crypto Network
                </h3>
                <p class="text-sm sm:text-base text-text-muted leading-relaxed">
                  Supporting decentralized infrastructure. I accept USDT / USDC
                  / MATIC on Polygon.
                </p>
              </div>

              <div class="pt-5 sm:pt-6 border-t border-th-border space-y-4">
                <div class="flex items-center justify-between gap-1">
                  <span
                    class="text-[8px] sm:text-[9px] font-black uppercase tracking-widest text-text-muted whitespace-nowrap"
                    >Net: <span class="text-rose-accent">Polygon</span></span
                  >
                  <span
                    class="text-[8px] sm:text-[9px] font-black uppercase tracking-widest text-text-muted whitespace-nowrap"
                    >Asset: <span class="text-rose-accent">USDT</span></span
                  >
                </div>

                <div
                  class="relative group/wallet cursor-pointer min-w-0"
                  id="copy-wallet"
                  data-wallet={WALLET_ADDRESS}
                >
                  <div
                    class="bg-surface-muted/50 rounded-2xl px-3 sm:px-5 py-3 sm:py-4 flex items-center justify-between border border-th-border group-hover/wallet:border-rose-accent/40 group-hover/wallet:bg-surface-muted transition-all duration-300"
                  >
                    <div class="flex-1 min-w-0 pr-3">
                      <span
                        class="text-[9px] sm:text-[10px] font-mono text-text-muted truncate block"
                        >{WALLET_ADDRESS}</span
                      >
                    </div>
                    <div
                      class="shrink-0 flex items-center gap-2 text-rose-accent"
                    >
                      <span
                        id="copy-text"
                        class="text-[8px] font-black uppercase tracking-tighter hidden sm:inline-block opacity-0 group-hover/wallet:opacity-100 transition-opacity"
                        >Copy</span
                      >
                      <div class="relative w-4 h-4">
                        <Copy
                          id="copy-icon"
                          class="w-4 h-4 absolute inset-0 transition-all duration-300"
                          stroke-width={2.5}
                        />
                        <Check
                          id="check-icon"
                          class="w-4 h-4 absolute inset-0 scale-0 opacity-0 text-emerald-500 transition-all duration-300"
                          stroke-width={3}
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <p
              class="mt-8 text-[9px] text-text-muted font-medium uppercase tracking-[0.2em] text-center italic"
            >
              "Your support means the world 🖤"
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initDonations() {
    const section = document.querySelector("#donations");
    if (!section) return;

    gsap.to(".donation-reveal", {
      scrollTrigger: {
        trigger: section,
        start: "top 85%",
        toggleActions: "play none none none",
      },
      y: 0,
      opacity: 1,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
    });

    const copyBtn = document.getElementById("copy-wallet");
    const walletAddress = copyBtn?.getAttribute("data-wallet");
    const copyText = document.getElementById("copy-text");
    const copyIcon = document.getElementById("copy-icon");
    const checkIcon = document.getElementById("check-icon");

    copyBtn?.addEventListener("click", async () => {
      if (!walletAddress) return;
      try {
        await navigator.clipboard.writeText(walletAddress);
        if (copyText) copyText.innerText = "Copied!";
        copyIcon?.classList.add("scale-0", "opacity-0");
        checkIcon?.classList.remove("scale-0", "opacity-0");
        checkIcon?.classList.add("scale-100", "opacity-100");

        setTimeout(() => {
          if (copyText) copyText.innerText = "Copy";
          copyIcon?.classList.remove("scale-0", "opacity-0");
          checkIcon?.classList.add("scale-0", "opacity-0");
          checkIcon?.classList.remove("scale-100", "opacity-100");
        }, 2000);
      } catch (err) {
        console.error("Failed to copy!", err);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initDonations);
</script>

<style>
  .donation-reveal {
    opacity: 0;
    transform: translateY(30px);
    will-change: transform, opacity;
  }
</style>
