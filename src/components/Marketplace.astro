---
import { translations } from "../i18n/translations.js";
import { productsList } from "../data/marketplace.js";
import { ArrowRight } from "lucide-astro";

const t = translations.en;
const products = productsList.map((p) => {
  const itemData =
    t.marketplace.items[p.id as keyof typeof t.marketplace.items];
  return { ...p, ...itemData };
});
---

<section
  id="marketplace"
  class="py-44 relative bg-surface border-t border-th-border overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="marketplace-header opacity-0 translate-y-10 mb-24">
      <div class="space-y-10">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px bg-accent"></span>
          <span
            class="text-[10px] font-black uppercase tracking-[0.4em] text-text-muted"
            >Assets</span
          >
        </div>

        <div
          class="flex flex-col md:flex-row md:items-end justify-between gap-8"
        >
          <div class="space-y-6 flex-1">
            <h2
              class="text-4xl sm:text-6xl md:text-8xl font-[Outfit] font-black text-text-primary leading-[0.9] tracking-tighter wrap-break-word"
              data-i18n="marketplace.title"
            >
              {t.marketplace.title}
            </h2>
            <p
              class="text-xl text-text-muted font-light leading-relaxed max-w-xl"
              data-i18n="marketplace.subtitle"
            >
              {t.marketplace.subtitle}
            </p>
          </div>

          <a
            href="/marketplace"
            class="hidden md:inline-flex items-center gap-2 px-8 py-4 bg-accent/10 hover:bg-accent text-accent hover:text-white font-bold rounded-2xl transition-all duration-300 group"
          >
            <span data-i18n="marketplace.title">{t.marketplace.title}</span>
            <ArrowRight
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 showroom-grid">
      {
        products.map((product) => (
          <a
            href={`/marketplace/${product.id}`}
            class="showroom-item opacity-0 translate-y-10 group relative bg-surface rounded-3xl p-6 sm:p-8 border border-th-border shadow-lg hover:shadow-2xl hover:border-accent/50 transition-all duration-500 cursor-pointer text-left flex flex-col justify-between h-full"
          >
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-accent/5 rounded-full blur-3xl group-hover:bg-accent/10 transition-colors duration-500 z-0" />

            <div class="relative z-10">
              <div class="flex items-start justify-between mb-4">
                <h3
                  class="text-2xl font-[Outfit] font-bold text-text-primary group-hover:text-accent transition-colors duration-300"
                  data-i18n={`marketplace.items.${product.id}.name`}
                >
                  {product.name}
                </h3>
                <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center shrink-0 group-hover:bg-accent group-hover:-rotate-45 transition-all duration-300">
                  <ArrowRight class="w-5 h-5 text-accent group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <p
                class="text-text-muted text-sm sm:text-base leading-relaxed mb-6"
                data-i18n={`marketplace.items.${product.id}.shortDesc`}
              >
                {product.shortDesc}
              </p>

              <div class="flex flex-wrap gap-2 mb-8">
                {product.topics.slice(0, 3).map((topic: string) => (
                  <span class="px-3 py-1 bg-surface-muted text-text-secondary text-xs font-semibold rounded-lg border border-th-border transition-colors group-hover:border-accent/30">
                    {topic}
                  </span>
                ))}
                {product.topics.length > 3 && (
                  <span class="px-3 py-1 bg-surface-muted text-text-secondary text-xs font-semibold rounded-lg border border-th-border">
                    +{product.topics.length - 3}
                  </span>
                )}
              </div>
            </div>

            <div class="pt-6 border-t border-th-border flex justify-between items-center relative z-10">
              <div class="flex items-center gap-3">
                <span
                  class="text-xl sm:text-2xl font-[Outfit] font-extrabold text-text-primary"
                  data-i18n={`marketplace.items.${product.id}.priceARS`}
                >
                  {product.priceARS}
                </span>
                <span class="w-1 h-1 bg-text-muted rounded-full" />
                <span
                  class="text-text-muted font-bold text-sm"
                  data-i18n={`marketplace.items.${product.id}.priceUSD`}
                >
                  {product.priceUSD}
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="md:hidden flex justify-center mt-8">
      <a
        href="/marketplace"
        class="inline-flex items-center justify-center w-full gap-2 px-8 py-4 bg-accent/10 hover:bg-accent text-accent hover:text-white font-bold rounded-2xl transition-all duration-300 group"
      >
        <span data-i18n="marketplace.title">{t.marketplace.title}</span>
        <ArrowRight
          class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("marketplace");
    if (!section) return;

    gsap.to(".marketplace-header", {
      scrollTrigger: {
        trigger: "#marketplace",
        start: "top 85%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power3.out",
    });

    gsap.to(".showroom-item", {
      scrollTrigger: {
        trigger: ".showroom-grid",
        start: "top 85%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.2,
      ease: "power3.out",
    });
  });
</script>
