---
import { translations } from "../i18n/translations.js";
import { workExperience, education } from "../i18n/data.js";
import { Briefcase, GraduationCap } from "lucide-astro";
import { Image } from "astro:assets";

import niuro from "../assets/work/niuro.jpg";
import dotLogo from "../assets/work/dot-logo.svg";
import zatoboxWork from "../assets/work/zatobox.jpg";
import dragonPyramid from "../assets/work/dragon-pyramid.jpg";
import tokenitIcon from "../assets/work/tokenit-icon.png";

import daVinci from "../assets/student/da-vinci.png";
import issd from "../assets/student/issd.png";
import codigoFacilito from "../assets/student/codigo-facilito.png";
import henry from "../assets/student/henry.jpg";
import coderhouse from "../assets/student/coderhouse.jpg";

const workLogos: Record<number, any> = {
  1: niuro,
  2: zatoboxWork,
  3: dragonPyramid,
  4: dotLogo,
};

const clientLogos: Record<string, any> = {
  Tokenit: tokenitIcon,
};

const eduLogos: Record<number, any> = {
  1: issd,
  2: codigoFacilito,
  3: henry,
  4: coderhouse,
  5: daVinci,
};

const t = translations.en;
---

<section
  id="experience"
  class="section-animate py-32 border-t border-white/5 relative"
>
  <div class="max-w-7xl mx-auto px-8 sm:px-12">

    <div class="mb-20">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-accent"></span>
        <span class="text-[10px] font-black uppercase tracking-[0.4em] text-accent/60">History</span>
      </div>
      <h2
        class="text-5xl md:text-7xl font-[Outfit] font-black text-white leading-[0.9] tracking-tighter"
        data-i18n="experience.title"
      >
        {t.experience.title}
      </h2>
      <p
        class="text-white/40 text-lg font-light leading-relaxed max-w-xl mt-4"
        data-i18n="experience.subtitle"
      >
        {t.experience.subtitle}
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">

      <!-- Work Experience -->
      <div>
        <h3 class="text-sm font-[Outfit] font-bold text-white mb-8 flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-accent/15 border border-accent/20 shrink-0 flex items-center justify-center">
            <Briefcase class="w-4 h-4 text-accent-text" />
          </span>
          <span data-i18n="experience.work">{t.experience.work}</span>
        </h3>

        <div class="relative">
          <div class="absolute left-5 top-0 bottom-0 w-px bg-white/6"></div>

          {workExperience.map((job) => (
            <div class="relative pl-14 pb-10 last:pb-0 group">
              <div class={`absolute left-[17px] top-3 w-2.5 h-2.5 rounded-full border-2 z-10 transition-colors duration-300 ${job.isCurrent ? "bg-accent border-accent" : "bg-transparent border-white/20 group-hover:border-accent/60"}`} />

              <div class={`rounded-2xl p-5 border transition-all duration-500 relative ${job.isCurrent ? "bg-accent/[0.06] border-accent/25" : "bg-white/[0.02] border-white/6 group-hover:bg-white/[0.04] group-hover:border-white/12"}`}>
                {job.isCurrent && (
                  <div class="absolute -top-2.5 right-4 px-2.5 py-0.5 bg-accent text-white text-[9px] font-bold rounded-full uppercase tracking-widest">
                    Currently
                  </div>
                )}

                <div class="flex items-start gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl shrink-0 bg-white/5 border border-white/8 overflow-hidden">
                    <Image
                      src={workLogos[job.id]}
                      alt={job.company.en}
                      width={40}
                      height={40}
                      quality={80}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-0.5">
                      <h4
                        class="font-[Outfit] font-bold text-white text-base work-company"
                        data-lang-en={job.company.en}
                        data-lang-es={job.company.es}
                        data-lang-pt={job.company.pt}
                        data-lang-ja={job.company.ja}
                      >
                        {job.company.en}
                      </h4>
                      <span class="text-[9px] font-bold text-white/25 uppercase tracking-wider whitespace-nowrap">
                        {job.period}
                      </span>
                    </div>
                    <p
                      class="text-accent-text/70 text-xs font-bold uppercase tracking-wider work-role"
                      data-lang-en={job.role.en}
                      data-lang-es={job.role.es}
                      data-lang-pt={job.role.pt}
                      data-lang-ja={job.role.ja}
                    >
                      {job.role.en}
                    </p>
                  </div>
                </div>

                <p
                  class="text-white/40 text-sm leading-relaxed work-desc"
                  data-lang-en={job.description.en}
                  data-lang-es={job.description.es}
                  data-lang-pt={job.description.pt}
                  data-lang-ja={job.description.ja}
                >
                  {job.description.en}
                </p>

                {job.client && (
                  <div class="mt-4 pt-4 border-t border-white/6">
                    <p class="text-[9px] font-black uppercase tracking-[0.3em] text-white/25 mb-2">Client</p>
                    <div class="flex items-center gap-2 flex-wrap">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-lg overflow-hidden border border-white/10 bg-white/5 shrink-0">
                          <Image
                            src={clientLogos[job.client]}
                            alt={job.client}
                            width={24}
                            height={24}
                            quality={80}
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </div>
                        <span class="text-sm font-bold text-white/70">{job.client}</span>
                      </div>
                      <div class="flex flex-wrap gap-1.5">
                        <a
                          href={job.clientUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[10px] font-bold text-accent-text border border-accent/25 bg-accent/8 hover:bg-accent/15 px-2 py-0.5 rounded-full transition-all duration-200"
                        >
                          tokenit.cl
                        </a>
                        <a
                          href="https://app.tokenit.cl"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[10px] font-bold text-white/40 border border-white/10 hover:border-accent/25 hover:text-accent-text px-2 py-0.5 rounded-full transition-all duration-200"
                        >
                          app.tokenit.cl
                        </a>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Education -->
      <div>
        <h3 class="text-sm font-[Outfit] font-bold text-white mb-8 flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-white/6 border border-white/10 shrink-0 flex items-center justify-center">
            <GraduationCap class="w-4 h-4 text-white/60" />
          </span>
          <span data-i18n="experience.education">{t.experience.education}</span>
        </h3>

        <div class="relative">
          <div class="absolute left-5 top-0 bottom-0 w-px bg-white/6"></div>

          {education.map((edu) => (
            <div class="relative pl-14 pb-10 last:pb-0 group">
              <div class={`absolute left-[17px] top-3 w-2.5 h-2.5 rounded-full border-2 z-10 transition-colors duration-300 ${edu.isCurrent ? "bg-accent border-accent" : "bg-transparent border-white/20 group-hover:border-white/50"}`} />

              <div class={`rounded-2xl p-5 border transition-all duration-500 relative ${edu.isCurrent ? "bg-accent/[0.05] border-accent/20" : "bg-white/[0.02] border-white/6 group-hover:bg-white/[0.04] group-hover:border-white/12"}`}>
                {edu.isCurrent && (
                  <div class="absolute -top-2.5 right-4 px-2.5 py-0.5 bg-accent text-white text-[9px] font-bold rounded-full uppercase tracking-widest">
                    Currently
                  </div>
                )}

                <div class="flex items-start gap-3 mb-3">
                  <div
                    class="w-10 h-10 rounded-xl shrink-0 overflow-hidden border border-white/8 flex items-center justify-center"
                    style={edu.institution.en.includes("Da Vinci") ? "background-color:#141516" : "background-color:#f9fafb"}
                  >
                    <Image
                      src={eduLogos[edu.id]}
                      alt={edu.institution.en}
                      width={40}
                      height={40}
                      quality={80}
                      loading="lazy"
                      class={`w-full h-full object-contain ${edu.institution.en.includes("Da Vinci") ? "scale-110" : "p-1"}`}
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-0.5">
                      <h4
                        class="font-[Outfit] font-bold text-white text-base edu-institution"
                        data-lang-en={edu.institution.en}
                        data-lang-es={edu.institution.es}
                        data-lang-pt={edu.institution.pt}
                        data-lang-ja={edu.institution.ja}
                      >
                        {edu.institution.en}
                      </h4>
                      <span class="text-[9px] font-bold text-white/25 uppercase tracking-wider whitespace-nowrap">
                        {edu.period}
                      </span>
                    </div>
                    <p
                      class="text-white/50 text-xs font-bold edu-degree"
                      data-lang-en={edu.degree.en}
                      data-lang-es={edu.degree.es}
                      data-lang-pt={edu.degree.pt}
                      data-lang-ja={edu.degree.ja}
                    >
                      {edu.degree.en}
                    </p>
                  </div>
                </div>

                <p
                  class="text-white/35 text-sm leading-relaxed edu-desc"
                  data-lang-en={edu.description.en}
                  data-lang-es={edu.description.es}
                  data-lang-pt={edu.description.pt}
                  data-lang-ja={edu.description.ja}
                >
                  {edu.description.en}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
