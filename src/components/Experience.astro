---
import { translations } from "../i18n/translations.js";
import { workExperience, education } from "../i18n/data.js";
import { Briefcase, GraduationCap } from "lucide-astro";
import { Image } from "astro:assets";

import niuro from "../assets/work/niuro.jpg";
import dotLogo from "../assets/work/dot-logo.svg";
import zatoboxWork from "../assets/work/zatobox.jpg";
import dragonPyramid from "../assets/work/dragon-pyramid.jpg";

import daVinci from "../assets/student/da-vinci.png";
import issd from "../assets/student/issd.png";
import codigoFacilito from "../assets/student/codigo-facilito.png";
import henry from "../assets/student/henry.jpg";
import coderhouse from "../assets/student/coderhouse.jpg";

const logos: Record<number, any> = {
  // Work (Experience)
  1: niuro,
  2: zatoboxWork,
  3: dragonPyramid,
  4: dotLogo,
  // Education
  101: issd, // Adjusted IDs for education to avoid collision if any
  102: codigoFacilito,
  103: henry,
  104: coderhouse,
  105: daVinci,
};

// Map IDs in data.js to the logos
const workLogos: Record<number, any> = {
  1: niuro,
  2: zatoboxWork,
  3: dragonPyramid,
  4: dotLogo,
};

const eduLogos: Record<number, any> = {
  1: issd,
  2: codigoFacilito,
  3: henry,
  4: coderhouse,
  5: daVinci,
};

const t = translations.en;
---

<section
  id="experience"
  class="py-44 bg-white border-t border-gray-100 relative overflow-x-hidden"
>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="experience-header opacity-0 translate-y-10 mb-24">
      <div class="space-y-10">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px bg-accent"></span>
          <span
            class="text-[10px] font-black uppercase tracking-[0.4em] text-gray-400"
            >History</span
          >
        </div>

        <div class="space-y-6">
          <h2
            class="text-6xl md:text-8xl font-[Outfit] font-black text-gray-950 leading-[0.9] tracking-tighter"
            data-i18n="experience.title"
          >
            {t.experience.title}
          </h2>
          <p
            class="text-xl text-gray-500 font-light leading-relaxed max-w-xl"
            data-i18n="experience.subtitle"
          >
            {t.experience.subtitle}
          </p>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">
      <div class="w-full min-w-0">
        <h3
          class="text-xl font-[Outfit] font-semibold text-text-primary mb-8 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 rounded-xl bg-text-primary shrink-0 flex items-center justify-center shadow-lg shadow-text-primary/20"
          >
            <Briefcase class="w-5 h-5 text-white" />
          </span>
          <span data-i18n="experience.work">{t.experience.work}</span>
        </h3>

        <div class="relative">
          <div class="absolute left-6 top-0 bottom-0 w-px bg-gray-200"></div>

          {
            workExperience.map((job) => (
              <div class="experience-item opacity-0 translate-y-10 relative pl-12 sm:pl-16 pb-12 last:pb-0 group w-full">
                <div
                  class={`absolute left-4.5 top-2 w-3 h-3 rounded-full bg-white border-2 z-10 transition-colors duration-300 ${job.isCurrent ? "border-text-primary" : "border-text-primary"}`}
                />

                <div
                  class={`bg-white rounded-3xl p-5 sm:p-6 border transition-all duration-500 relative w-full ${job.isCurrent ? "border-text-primary ring-1 ring-text-primary/10 shadow-2xl shadow-text-primary/10" : "border-gray-100 group-hover:border-text-primary group-hover:shadow-xl group-hover:shadow-text-primary/10"}`}
                >
                  {job.isCurrent && (
                    <div class="absolute -top-3 right-4 sm:right-6 px-3 py-1 bg-text-primary text-white text-[10px] font-bold rounded-full uppercase tracking-widest shadow-lg shadow-text-primary/20">
                      Currently
                    </div>
                  )}

                  <div class="flex flex-col sm:flex-row items-start gap-4 mb-4">
                    <div class="w-12 h-12 rounded-xl shrink-0 bg-gray-50 border border-gray-100 overflow-hidden">
                      <Image
                        src={workLogos[job.id]}
                        alt={job.company.en}
                        width={48}
                        height={48}
                        quality={80}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <div class="flex-1 min-w-0 w-full">
                      <div class="flex wrap items-center justify-between gap-2 mb-1">
                        <h4
                          class="text-lg font-[Outfit] font-bold text-text-primary work-company"
                          data-job-id={job.id}
                          data-lang-en={job.company.en}
                          data-lang-es={job.company.es}
                        >
                          {job.company.en}
                        </h4>
                        <span class="text-[10px] font-bold text-text-muted bg-gray-50 px-3 py-1 rounded-full uppercase tracking-wider whitespace-nowrap">
                          {job.period}
                        </span>
                      </div>
                      <p
                        class="text-text-secondary text-sm font-bold work-role"
                        data-job-id={job.id}
                        data-lang-en={job.role.en}
                        data-lang-es={job.role.es}
                      >
                        {job.role.en}
                      </p>
                    </div>
                  </div>

                  <p
                    class="text-text-muted text-sm leading-relaxed work-desc"
                    data-job-id={job.id}
                    data-lang-en={job.description.en}
                    data-lang-es={job.description.es}
                  >
                    {job.description.en}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="w-full min-w-0">
        <h3
          class="text-xl font-[Outfit] font-semibold text-text-primary mb-8 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 rounded-xl bg-rose-accent shrink-0 flex items-center justify-center shadow-lg shadow-rose-accent/20"
          >
            <GraduationCap class="w-5 h-5 text-white" />
          </span>
          <span data-i18n="experience.education">{t.experience.education}</span>
        </h3>

        <div class="relative">
          <div class="absolute left-6 top-0 bottom-0 w-px bg-gray-200"></div>

          {
            education.map((edu) => (
              <div class="education-item opacity-0 translate-y-10 relative pl-12 sm:pl-16 pb-12 last:pb-0 group w-full">
                <div
                  class={`absolute left-4.5 top-2 w-3 h-3 rounded-full bg-white border-2 z-10 transition-colors duration-300 ${edu.isCurrent ? "border-rose-accent" : "border-gray-300 group-hover:bg-text-primary group-hover:border-text-primary"}`}
                />

                <div
                  class={`bg-white rounded-3xl p-5 sm:p-6 border transition-all duration-500 relative w-full ${edu.isCurrent ? "border-rose-accent ring-1 ring-rose-accent/30 shadow-2xl shadow-rose-soft/40" : "border-gray-100 group-hover:border-rose-accent group-hover:shadow-xl group-hover:shadow-rose-soft/20"}`}
                >
                  {edu.isCurrent && (
                    <div class="absolute -top-3 right-4 sm:right-6 px-3 py-1 bg-rose-accent text-white text-[10px] font-bold rounded-full uppercase tracking-widest shadow-lg shadow-rose-accent/20">
                      Currently
                    </div>
                  )}
                  <div class="flex flex-col sm:flex-row items-start gap-4 mb-2">
                    <div
                      class="w-12 h-12 rounded-xl shrink-0 overflow-hidden border border-gray-100 flex items-center justify-center"
                      style={
                        edu.institution.en.includes("Da Vinci")
                          ? "background-color: #141516"
                          : "background-color: #f9fafb"
                      }
                    >
                      <Image
                        src={eduLogos[edu.id]}
                        alt={edu.institution.en}
                        width={48}
                        height={48}
                        quality={80}
                        loading="lazy"
                        decoding="async"
                        class={`w-full h-full object-contain ${edu.institution.en.includes("Da Vinci") ? "scale-110" : "p-1"}`}
                      />
                    </div>
                    <div class="flex-1 min-w-0 w-full">
                      <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                        <h4
                          class="text-lg font-[Outfit] font-bold text-text-primary edu-institution"
                          data-edu-id={edu.id}
                          data-lang-en={edu.institution.en}
                          data-lang-es={edu.institution.es}
                        >
                          {edu.institution.en}
                        </h4>
                        <span class="text-[10px] font-bold text-text-muted bg-gray-50 px-3 py-1 rounded-full uppercase tracking-wider whitespace-nowrap">
                          {edu.period}
                        </span>
                      </div>
                      <p
                        class="text-rose-accent text-sm font-bold edu-degree"
                        data-edu-id={edu.id}
                        data-lang-en={edu.degree.en}
                        data-lang-es={edu.degree.es}
                      >
                        {edu.degree.en}
                      </p>
                    </div>
                  </div>

                  <p
                    class="text-text-muted text-sm leading-relaxed edu-desc"
                    data-edu-id={edu.id}
                    data-lang-en={edu.description.en}
                    data-lang-es={edu.description.es}
                  >
                    {edu.description.en}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.to(".experience-header", {
      scrollTrigger: {
        trigger: "#experience",
        start: "top 85%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power3.out",
    });

    gsap.to(".experience-item", {
      scrollTrigger: {
        trigger: "#experience",
        start: "top 75%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      x: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
    });

    gsap.to(".education-item", {
      scrollTrigger: {
        trigger: "#experience",
        start: "top 75%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      x: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
    });
  });
</script>
