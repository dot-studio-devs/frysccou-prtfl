---
import { translations } from "../i18n/translations.js";
import { ArrowRight } from "lucide-astro";
import { Image } from "astro:assets";
import me from "../assets/images/me.png";
import dotLogo from "../assets/work/dot-logo.svg";

const t = translations.en;
---

<section
  id="contact"
  class="py-44 bg-surface border-t border-th-border relative overflow-hidden"
>
  <div class="max-w-4xl mx-auto px-6 relative z-10">
    <div class="contact-content opacity-0 translate-y-10">
      <div class="contact-header mb-20 space-y-10">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px bg-accent"></span>
          <span
            class="text-[10px] font-black uppercase tracking-[0.4em] text-text-muted"
            >Inquiry</span
          >
        </div>

        <div
          class="flex flex-col md:flex-row gap-12 items-start justify-between"
        >
          <div class="space-y-6 max-w-2xl">
            <h2
              class="text-6xl md:text-8xl font-[Outfit] font-black text-text-primary leading-[0.9] tracking-tighter"
              data-i18n="contact.title"
            >
              {t.contact.title}
            </h2>
            <p
              class="text-xl text-text-muted font-light leading-relaxed"
              data-i18n="contact.subtitle"
            >
              {t.contact.subtitle}
            </p>
          </div>

          <div class="shrink-0">
            <div
              class="w-32 h-32 rounded-full border-4 border-surface shadow-2xl shadow-accent-soft/50 ring-1 ring-th-border overflow-hidden"
            >
              <Image
                src={me}
                alt="Francisco"
                width={200}
                height={200}
                format="webp"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-16"
      >
        <a
          href="mailto:franespindola71@gmail.com"
          class="group px-12 py-5 bg-th-btn-dark text-th-btn-dark-text rounded-2xl font-bold text-lg transition-all duration-300 hover:bg-accent hover:text-white hover:scale-105 hover:shadow-2xl hover:shadow-accent/40 flex items-center gap-2"
        >
          <span data-i18n="contact.cta">{t.contact.cta}</span>
          <ArrowRight
            class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>

      <div
        class="flex items-center justify-center gap-4 text-text-muted mb-12 mx-auto"
      >
        <div class="h-px w-16 bg-th-border-secondary"></div>
        <span
          class="text-xs font-bold uppercase tracking-widest"
          data-i18n="contact.or">{t.contact.or}</span
        >
        <div class="h-px w-16 bg-th-border-secondary"></div>
      </div>

      <a
        href="https://dot-studio.site"
        target="_blank"
        rel="noopener noreferrer"
        class="block group w-full max-w-md mx-auto"
      >
        <div
          class="bg-surface rounded-3xl p-8 border border-th-border hover:border-accent transition-all duration-500 hover:shadow-2xl hover:shadow-accent-soft/30 hover:-translate-y-2 text-center"
        >
          <div class="flex flex-col items-center gap-4 mb-6">
            <div
              class="w-20 h-20 rounded-2xl bg-surface border border-th-border flex items-center justify-center overflow-hidden shadow-xl shadow-th-border-secondary/50"
            >
              <Image
                src={dotLogo}
                alt="Dot Studio"
                width={48}
                height={48}
                class="w-12 h-12 object-contain"
              />
            </div>
            <div>
              <h3 class="text-2xl font-[Outfit] font-bold text-text-primary">
                Dot Studio
              </h3>
              <p class="text-accent font-bold tracking-wider">
                dot-studio.site
              </p>
            </div>
          </div>
          <p
            class="text-text-muted text-base leading-relaxed mb-8"
            data-i18n="contact.studioDescription"
          >
            {t.contact.studioDescription}
          </p>
          <div
            class="flex items-center justify-center gap-2 text-text-primary font-bold transition-all duration-300 group-hover:text-accent group-hover:gap-4"
          >
            <span>Visit Studio Website</span>
            <ArrowRight class="w-5 h-5 transition-transform" />
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.to(".contact-content", {
      scrollTrigger: {
        trigger: "#contact",
        start: "top 80%",
        toggleActions: "play none none none",
      },
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "power3.out",
    });
  });
</script>
