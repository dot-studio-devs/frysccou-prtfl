---
import "../styles/globals.css";
import DotStudioPortal from "../components/work/DotStudioPortal.astro";
import SettingsModal from "../components/SettingsModal.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImage?: string;
  keywords?: string;
}

const {
  title = "Francisco Espindola — Web Engineer crafting high-performance web experiences",
  description = "Web Engineer based in Buenos Aires, building high-performance web applications, premium interfaces and motion-driven experiences with Astro, React, TypeScript and Tailwind CSS. End-to-end work across design, performance and edge-ready architectures.",
  image = "/ysc.png",
  ogImage = "/ysc.png",
  keywords = "Francisco Espindola, Frysccou, Web Engineer, web engineering, design-led engineering, performance engineering, UI/UX engineering, motion design, frontend engineer, full stack capabilities, Astro developer, React engineer, TypeScript, Tailwind CSS, GSAP, edge web applications, scalable web architecture, premium interfaces, high-performance web apps, Buenos Aires, Argentina, hire web engineer, freelance web engineer, Dot Studio",
} = Astro.props;

const SUPPORTED_LANGS = ["en", "es", "pt", "ja"] as const;
type SupportedLang = (typeof SUPPORTED_LANGS)[number];
const cookieLang = Astro.cookies.get("selected-lang")?.value as
  | SupportedLang
  | undefined;
const lang: SupportedLang =
  cookieLang && SUPPORTED_LANGS.includes(cookieLang) ? cookieLang : "en";

const ogLocaleMap: Record<SupportedLang, string> = {
  en: "en_US",
  es: "es_ES",
  pt: "pt_BR",
  ja: "ja_JP",
};
const ogLocale = ogLocaleMap[lang];
const ogLocaleAlternates = SUPPORTED_LANGS.filter((l) => l !== lang).map(
  (l) => ogLocaleMap[l]
);

const siteName = "Francisco Espindola Portfolio";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.href);
const fullOgImage = new URL(ogImage, Astro.site || Astro.url.href).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Francisco Espindola",
  alternateName: ["Frysccou", "Esspindola"],
  url: (Astro.site || Astro.url.href).toString(),
  image: fullOgImage,
  jobTitle: "Web Engineer",
  description:
    "Web Engineer working end-to-end across the full stack to craft high-performance web applications, premium interfaces and motion-driven digital experiences.",
  knowsAbout: [
    "Web Engineering",
    "Full Stack Development",
    "UI/UX Engineering",
    "Motion Design",
    "Performance Engineering",
    "Web Architecture",
    "Astro",
    "React",
    "TypeScript",
    "Tailwind CSS",
    "GSAP",
    "Node.js",
    "Edge Computing",
    "Hexagonal Architecture",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Buenos Aires",
    addressCountry: "AR",
  },
  worksFor: {
    "@type": "Organization",
    name: "Dot Studio",
    url: "https://dot-studio.site",
  },
  sameAs: [
    "https://github.com/esspindola",
    "https://www.linkedin.com/in/espindola-francisco",
    "https://instagram.com/frysccou",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: (Astro.site || Astro.url.href).toString(),
  inLanguage: ["en", "es", "pt", "ja"],
  author: { "@type": "Person", name: "Francisco Espindola" },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Francisco Espindola" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="googlebot"
      content="index, follow, max-snippet:-1, max-image-preview:large"
    />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Francisco Espindola — Web Engineer" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {
      ogLocaleAlternates.map((alt) => (
        <meta property="og:locale:alternate" content={alt} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content="Francisco Espindola — Web Engineer" />
    <meta name="twitter:creator" content="@frysccou" />
    <meta name="twitter:site" content="@frysccou" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <script is:inline>
      (function () {
        function getThemeCookie() {
          var match = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/);
          return match ? match[1] : null;
        }
        var saved = getThemeCookie();
        var theme = saved || "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <script is:inline>
      (function () {
        function syncReducedMotion() {
          var reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches;
          document.documentElement.setAttribute(
            "data-reduced-motion",
            reduced ? "true" : "false"
          );
        }
        syncReducedMotion();
        window
          .matchMedia("(prefers-reduced-motion: reduce)")
          .addEventListener("change", syncReducedMotion);
      })();
    </script>

    <script defer src="https://va.vercel-scripts.com/v1/analytics"></script>
  </head>
  <body
    class="bg-surface text-th-text font-[Inter] antialiased overflow-x-hidden"
  >
    <slot />
    <DotStudioPortal />
    <SettingsModal />
    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import {
        portfolioScrollMotion,
        prefersReducedMotion,
      } from "../lib/motion/runtime";

      gsap.registerPlugin(ScrollTrigger);

      declare global {
        interface Window {
          gsap: typeof gsap;
          ScrollTrigger: typeof ScrollTrigger;
          setTheme: (theme: string) => void;
          getTheme: () => string;
        }
      }

      window.gsap = gsap;
      window.ScrollTrigger = ScrollTrigger;

      document.addEventListener("DOMContentLoaded", () => {
        const nodes = document.querySelectorAll<HTMLElement>(
          "main .section-animate, footer.section-animate",
        );
        if (!nodes.length) return;

        const { header } = portfolioScrollMotion;
        if (prefersReducedMotion()) {
          gsap.set(nodes, { opacity: 1, y: 0, clearProps: "transform,opacity" });
          return;
        }

        gsap.set(nodes, { opacity: 0, y: 28 });

        nodes.forEach((el) => {
          const isHero = el.id === "hero";
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: header.duration,
            ease: header.ease,
            scrollTrigger: isHero
              ? undefined
              : {
                  trigger: el,
                  start: "top 88%",
                  toggleActions: "play none none none",
                },
          });
        });

        requestAnimationFrame(() => ScrollTrigger.refresh());
      });

      function setThemeCookie(theme: string) {
        var expires = new Date();
        expires.setDate(expires.getDate() + 14);
        document.cookie =
          "theme=" +
          theme +
          ";expires=" +
          expires.toUTCString() +
          ";path=/;SameSite=Lax";
      }

      function getThemeCookie(): string {
        var match = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/);
        return match ? match[1] : "light";
      }

      window.setTheme = function (theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        setThemeCookie(theme);
        window.dispatchEvent(new CustomEvent("themeChange", { detail: theme }));
      };

      window.getTheme = function () {
        return document.documentElement.getAttribute("data-theme") || "light";
      };
    </script>
  </body>
</html>
