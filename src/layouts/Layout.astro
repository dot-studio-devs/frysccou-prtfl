---
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "YSC Studio — Francisco Espindola · Full Stack Engineer",
  description = "YSC is the studio of Francisco Espindola — a Full Stack Engineer building premium digital products end to end, from pixel-perfect interfaces to scalable system architecture.",
  image = "/brand/og.png",
} = Astro.props;

const siteURL = Astro.site ?? new URL(Astro.url.href);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = new URL(image, siteURL);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: "YSC Studio",
      description,
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": `${siteURL}#person`,
      name: "Francisco Espindola",
      alternateName: "frysccou",
      url: siteURL,
      image: ogImage,
      jobTitle: "Full Stack Engineer",
      worksFor: { "@type": "Organization", name: "YSC Studio" },
      address: { "@type": "PostalAddress", addressLocality: "Buenos Aires", addressCountry: "AR" },
      sameAs: [
        "https://github.com/esspindola",
        "https://www.linkedin.com/in/espindola-francisco",
        "https://instagram.com/frysccou",
      ],
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Francisco Espindola" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content="#1a1517" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YSC Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YSC Studio — Francisco Espindola" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@frysccou" />
    <meta name="twitter:creator" content="@frysccou" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="icon" type="image/x-icon" href="/brand/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/brand/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;500;600;700;900&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&family=JetBrains+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <script defer src="https://va.vercel-scripts.com/v1/analytics"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
