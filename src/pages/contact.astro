---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { ArrowUpRight } from "lucide-astro";
---

<Layout
  title="Contact — YSC by frysccou"
  description="Get in touch with Francisco Espindola (frysccou) — available for freelance projects, collaborations, and full-time opportunities."
>
  <main class="pt-32 pb-20 min-h-screen flex flex-col">
    <div class="max-w-5xl mx-auto px-8 sm:px-12 w-full flex-1 flex flex-col justify-center">

      <div class="mb-20 space-y-5">
        <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-accent/70 block">
          Let's talk
        </span>
        <h1 class="text-7xl md:text-9xl font-[Outfit] font-black text-white leading-[0.88] tracking-tighter">
          Contact.
        </h1>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
        <div class="space-y-8">
          <p class="text-white/50 text-xl leading-relaxed">
            Open for freelance projects, long-term collaborations, and full-time opportunities.
            Reach out — I usually respond within 24 hours.
          </p>

          <div class="space-y-1">
            <a
              href="mailto:franespindola71@gmail.com"
              class="group flex items-center justify-between py-5 border-b border-white/8 hover:border-accent/30 transition-colors duration-300"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-1">Email</span>
                <span class="text-white/80 font-medium group-hover:text-white transition-colors">franespindola71@gmail.com</span>
              </div>
              <ArrowUpRight class="w-5 h-5 text-white/20 group-hover:text-accent-text transition-colors" />
            </a>

            <a
              href="https://www.linkedin.com/in/espindola-francisco"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between py-5 border-b border-white/8 hover:border-accent/30 transition-colors duration-300"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-1">LinkedIn</span>
                <span class="text-white/80 font-medium group-hover:text-white transition-colors">espindola-francisco</span>
              </div>
              <ArrowUpRight class="w-5 h-5 text-white/20 group-hover:text-accent-text transition-colors" />
            </a>

            <a
              href="https://github.com/esspindola"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between py-5 border-b border-white/8 hover:border-accent/30 transition-colors duration-300"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-1">GitHub</span>
                <span class="text-white/80 font-medium group-hover:text-white transition-colors">esspindola</span>
              </div>
              <ArrowUpRight class="w-5 h-5 text-white/20 group-hover:text-accent-text transition-colors" />
            </a>

            <a
              href="https://instagram.com/frysccou"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between py-5 border-b border-white/8 hover:border-accent/30 transition-colors duration-300"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-1">Instagram</span>
                <span class="text-white/80 font-medium group-hover:text-white transition-colors">@frysccou</span>
              </div>
              <ArrowUpRight class="w-5 h-5 text-white/20 group-hover:text-accent-text transition-colors" />
            </a>
          </div>
        </div>

        <div class="space-y-8">
          <div class="p-8 border border-white/8 rounded-2xl bg-white/[0.02] space-y-6">
            <h2 class="text-white font-[Outfit] font-bold text-2xl">Quick note</h2>

            <form
              name="contact"
              method="POST"
              action="mailto:franespindola71@gmail.com"
              class="space-y-5"
            >
              <div>
                <label class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-2">
                  Name
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full bg-white/[0.04] border border-white/10 rounded-lg px-4 py-3 text-white text-sm placeholder-white/20 focus:outline-none focus:border-accent/50 transition-colors duration-200"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-2">
                  Email
                </label>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full bg-white/[0.04] border border-white/10 rounded-lg px-4 py-3 text-white text-sm placeholder-white/20 focus:outline-none focus:border-accent/50 transition-colors duration-200"
                  placeholder="your@email.com"
                />
              </div>
              <div>
                <label class="text-[10px] font-bold uppercase tracking-widest text-white/30 block mb-2">
                  Message
                </label>
                <textarea
                  name="message"
                  required
                  rows={5}
                  class="w-full bg-white/[0.04] border border-white/10 rounded-lg px-4 py-3 text-white text-sm placeholder-white/20 focus:outline-none focus:border-accent/50 transition-colors duration-200 resize-none"
                  placeholder="Tell me about your project..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="group w-full flex items-center justify-center gap-3 py-4 bg-accent text-white rounded-full text-[11px] font-black uppercase tracking-widest hover:bg-accent/90 transition-all duration-300 shadow-lg shadow-accent/20"
              >
                Send message
                <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </button>
            </form>
          </div>

          <div class="flex items-center gap-3">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-widest text-white/30">
              Buenos Aires, Argentina — UTC-3
            </span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
