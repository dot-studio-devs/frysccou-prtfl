---
import { getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import CustomCursor from "../../components/CustomCursor.astro";
import Footer from "../../components/Footer.astro";
import BlogPost from "../../components/blog/BlogPost.astro";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/blog");

const post = await getEntry("blog", slug);

if (!post) return Astro.redirect("/404");

const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} — Francisco Espindola`}
  description={post.data.summary}
  ogImage={post.data.coverImage}
>
  <CustomCursor />
  <Sidebar />

  <div
    id="content-wrapper"
    class="transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] min-h-screen"
  >
    <main>
      <BlogPost post={post}>
        <Content />
      </BlogPost>
    </main>
    <Footer />
  </div>

  <button id="lang-toggle" class="hidden" aria-hidden="true"></button>
</Layout>

<style is:global>
  body.sidebar-expanded #content-wrapper {
    padding-left: 256px;
  }
  body.sidebar-collapsed #content-wrapper {
    padding-left: 80px;
  }

  @media (max-width: 768px) {
    body.sidebar-expanded #content-wrapper,
    body.sidebar-collapsed #content-wrapper {
      padding-left: 0;
      padding-top: 64px;
    }
  }
</style>

<script>
  import { translations } from "../../i18n/translations.js";

  let currentLang = "en";

  function updateTexts(lang: "en" | "es" | "pt" | "ja") {
    const t = (translations as any)[lang];

    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (!key) return;
      const keys = key.split(".");
      let value: any = t;
      for (const k of keys) {
        value = value?.[k];
      }
      if (value && typeof value === "string") {
        el.innerHTML = value;
      }
    });

    document.documentElement.lang = lang;
    document.cookie = `selected-lang=${lang}; path=/; max-age=31536000`;

    const event = new CustomEvent("languageChange", { detail: t });
    window.dispatchEvent(event);
  }

  function getLangCookie() {
    const match = document.cookie.match(/selected-lang=([^;]+)/);
    return match ? match[1] : "en";
  }

  document.addEventListener("DOMContentLoaded", () => {
    const langToggle = document.getElementById("lang-toggle");
    const currentLangSpan = document.getElementById("current-lang");

    const langs = ["en", "es", "pt", "ja"];
    let langIndex = 0;

    const initialLang = getLangCookie();
    langIndex = langs.indexOf(initialLang);
    if (langIndex === -1) langIndex = 0;
    currentLang = langs[langIndex];
    if (currentLangSpan)
      currentLangSpan.textContent = currentLang.toUpperCase();
    updateTexts(currentLang as any);

    langToggle?.addEventListener("click", () => {
      langIndex = (langIndex + 1) % langs.length;
      currentLang = langs[langIndex];
      if (currentLangSpan) {
        currentLangSpan.textContent = currentLang.toUpperCase();
      }
      updateTexts(currentLang as any);
    });
  });
</script>
