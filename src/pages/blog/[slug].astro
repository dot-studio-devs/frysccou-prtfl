---
import { getEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import CustomCursor from "../../components/CustomCursor.astro";
import Footer from "../../components/Footer.astro";
import BlogPost from "../../components/blog/BlogPost.astro";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/blog");

const post = await getEntry("blog", slug);

if (!post) return Astro.redirect("/404");

const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} — Francisco Espindola`}
  description={post.data.summary}
  ogImage={post.data.coverImage}
>
  <CustomCursor />
  <Sidebar />

  <div
    id="content-wrapper"
    class="transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] min-h-screen"
  >
    <main>
      <BlogPost post={post}>
        <Content />
      </BlogPost>
    </main>
    <Footer />
  </div>

</Layout>

<style is:global>
  body.sidebar-expanded #content-wrapper {
    padding-left: 256px;
  }
  body.sidebar-collapsed #content-wrapper {
    padding-left: 80px;
  }

  @media (max-width: 768px) {
    body.sidebar-expanded #content-wrapper,
    body.sidebar-collapsed #content-wrapper {
      padding-left: 0;
      padding-top: 64px;
    }
  }
</style>

<script>
  import { applyLanguage, getStoredLang } from "../../lib/i18n-runtime";

  document.addEventListener("DOMContentLoaded", () => {
    applyLanguage(getStoredLang());
  });
</script>
