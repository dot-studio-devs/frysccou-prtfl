---
import Layout from "../layouts/Layout.astro";
import { translations } from "../i18n/translations.js";
import { ArrowLeft, Compass, AlertCircle } from "lucide-astro";
import CustomCursor from "../components/CustomCursor.astro";

const t = translations.en;
---

<Layout title="404 | Lost in the Multiverse">
  <CustomCursor />
  <main
    class="min-h-screen relative flex items-center justify-center p-4 md:p-6 overflow-hidden bg-[#0a0a0a]"
  >
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,_rgba(193,255,114,0.05)_0%,_transparent_50%)]"
      >
      </div>
      <div
        class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] bg-accent/20 blur-[120px] rounded-full animate-pulse"
      >
      </div>
      <div
        class="absolute -bottom-[10%] -right-[10%] w-[40%] h-[40%] bg-rose-accent/10 blur-[120px] rounded-full animate-pulse [animation-delay:2s]"
      >
      </div>

      <div class="grid-overlay absolute inset-0 opacity-20"></div>
    </div>

    <div class="relative z-10 w-full max-w-4xl text-center">
      <div class="relative mb-8 md:mb-12 group">
        <div
          class="absolute inset-0 blur-3xl bg-accent/20 scale-75 group-hover:scale-110 transition-transform duration-1000"
        >
        </div>
        <h1
          class="text-[8rem] xs:text-[10rem] sm:text-[15rem] md:text-[22rem] font-[Outfit] font-black leading-none tracking-tighter text-white/5 select-none relative z-10"
        >
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center z-20">
          <div class="relative">
            <div
              class="absolute inset-0 bg-accent blur-2xl opacity-20 animate-pulse"
            >
            </div>
            <Compass
              class="w-16 h-16 sm:w-24 sm:h-24 md:w-32 md:h-32 text-accent animate-[spin_10s_linear_infinite]"
              stroke-width={1}
            />
          </div>
        </div>
      </div>

      <div class="space-y-8 md:space-y-12">
        <div class="space-y-4 px-4">
          <div
            class="flex items-center justify-center gap-2 text-accent/60 mb-2"
          >
            <AlertCircle class="w-4 h-4" />
            <span class="text-[10px] font-black uppercase tracking-[0.4em]"
              >Signal Disruption</span
            >
          </div>
          <h2
            class="text-3xl xs:text-4xl sm:text-5xl md:text-7xl font-[Outfit] font-black uppercase tracking-tighter italic text-white leading-tight"
            data-i18n="error404.title"
          >
            {t.error404.title}
          </h2>
          <p
            class="text-white/40 text-[10px] xs:text-xs sm:text-sm md:text-base max-w-sm sm:max-w-md mx-auto leading-relaxed uppercase tracking-[0.2em] font-medium"
            data-i18n="error404.message"
          >
            {t.error404.message}
          </p>
        </div>

        <div class="flex flex-col items-center pt-4 sm:pt-8 gap-6">
          <a
            href="/"
            class="group relative flex items-center gap-4 px-8 xs:px-10 py-4 sm:py-5 bg-accent text-black rounded-2xl font-black uppercase tracking-widest text-[10px] xs:text-xs hover:bg-[#d4ff9c] transition-all duration-500 hover:scale-105 active:scale-95 shadow-[0_0_40px_rgba(193,255,114,0.2)]"
          >
            <ArrowLeft
              class="w-4 h-4 transition-transform duration-500 group-hover:-translate-x-2"
            />
            <span data-i18n="error404.backHome">{t.error404.backHome}</span>
            <div
              class="absolute inset-0 rounded-2xl border border-white/20 scale-105 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-500"
            >
            </div>
          </a>

          <div class="flex gap-8 opacity-20 pointer-events-none">
            <div class="h-px w-12 bg-gradient-to-r from-transparent to-white">
            </div>
            <div class="h-px w-12 bg-gradient-to-l from-transparent to-white">
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { applyLanguage, getStoredLang } from "../lib/i18n-runtime";

  document.addEventListener("DOMContentLoaded", () => {
    applyLanguage(getStoredLang());
  });
</script>

<style>
  .grid-overlay {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(circle at center, black, transparent 80%);
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.2;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.4;
    }
  }

  .animate-pulse {
    animation: pulse 8s infinite ease-in-out;
  }

  @media (max-width: 350px) {
    h1 {
      font-size: 7rem !important;
    }
    h2 {
      font-size: 1.75rem !important;
    }
  }
</style>
