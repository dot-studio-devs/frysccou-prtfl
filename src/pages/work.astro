---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../i18n/data.js";
import { ArrowUpRight, Github } from "lucide-astro";
import { Image } from "astro:assets";

import liz from "../assets/projects/liz.png";
import consentido from "../assets/projects/consentido.png";
import zatobox from "../assets/projects/zatobox.png";
import dotstudio from "../assets/projects/dot-studio.png";
import lastaurinas from "../assets/projects/lastaurinas.png";
import tokenit from "../assets/projects/tokenit.png";
import tokenitApp from "../assets/projects/app-tokenit.png";

const projectImages: Record<number, any> = {
  1: liz,
  2: consentido,
  3: zatobox,
  4: dotstudio,
  5: lastaurinas,
  7: tokenit,
};

const tokenit_data = (projects as any[]).find((p) => p.id === 7);
const ORDER = [3, 2, 1, 5, 4];
const rest = ORDER.map((id) => (projects as any[]).find((p) => p.id === id)).filter(Boolean);

type ProjectCard = {
  id: number | string;
  title: string;
  description: string;
  liveUrl: string;
  aptitudes: string[];
  img: any;
  isNew?: boolean;
  codeUrl?: string;
  hideCode?: boolean;
  badge?: string;
};

const cards: ProjectCard[] = [
  {
    id: "tokenit-app",
    title: "Tokenit — Investor App",
    description: "Investor dashboard with real-time portfolio monitoring, KYC, digital signing, and AI-powered risk scoring. Built for scale, security, and transparency on the blockchain.",
    liveUrl: "https://app.tokenit.cl",
    aptitudes: tokenit_data?.aptitudes ?? [],
    img: tokenitApp,
    isNew: tokenit_data?.isNew,
    badge: "app.tokenit.cl",
  },
  {
    id: "tokenit-landing",
    title: "Tokenit — Landing & Marketplace",
    description: "Public-facing landing and marketplace for a Chilean collective real estate investment platform built on blockchain-tokenized assets.",
    liveUrl: "https://tokenit.cl",
    aptitudes: tokenit_data?.aptitudes ?? [],
    img: tokenit,
    badge: "tokenit.cl",
  },
  ...rest.map((p: any) => ({
    id: p.id,
    title: p.title.en.split("|")[0].trim(),
    description: p.description.en,
    liveUrl: p.liveUrl,
    aptitudes: p.aptitudes,
    img: projectImages[p.id],
    isNew: p.isNew,
    codeUrl: p.codeUrl,
    hideCode: p.hideCode,
  })),
];
---

<Layout
  title="Work — YSC by frysccou"
  description="Selected projects by Francisco Espindola (frysccou) — Full Stack Engineer building premium web experiences."
>
  <main class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-8 sm:px-12">

      <div class="mb-24 space-y-5">
        <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-accent/70 block">
          Portfolio
        </span>
        <h1 class="text-7xl md:text-9xl font-[Outfit] font-black text-white leading-[0.88] tracking-tighter">
          Work.
        </h1>
        <p class="text-white/40 text-lg max-w-lg leading-relaxed">
          A selection of projects I've engineered — from full-stack platforms to premium interfaces.
        </p>
      </div>

      <div class="space-y-3">
        {cards.map((project, index) => (
          <div class="group border border-white/6 rounded-2xl overflow-hidden hover:border-accent/20 transition-all duration-500 bg-white/[0.015] hover:bg-accent/[0.03]">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
              <div class="lg:col-span-4 relative overflow-hidden">
                {project.img ? (
                  <div class="aspect-[4/3] lg:aspect-auto lg:h-full min-h-48 overflow-hidden">
                    <Image
                      src={project.img}
                      alt={project.title}
                      width={480}
                      height={360}
                      class="w-full h-full object-cover opacity-60 group-hover:opacity-90 group-hover:scale-[1.03] transition-all duration-700"
                    />
                  </div>
                ) : (
                  <div class="aspect-[4/3] lg:aspect-auto lg:h-full min-h-48 bg-white/[0.03] flex items-center justify-center">
                    <span class="text-white/20 text-xs font-mono">No preview</span>
                  </div>
                )}
              </div>

              <div class="lg:col-span-8 p-8 lg:p-10 flex flex-col justify-between gap-8">
                <div class="space-y-5">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3 flex-wrap">
                      <span class="text-[10px] font-mono text-accent/40">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <h2 class="text-2xl md:text-3xl font-[Outfit] font-black text-white tracking-tight">
                        {project.title}
                      </h2>
                      {project.isNew && (
                        <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest border border-accent/30 text-accent-text bg-accent/10">
                          New
                        </span>
                      )}
                      {project.badge && (
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wide border border-white/10 text-white/30 font-mono">
                          {project.badge}
                        </span>
                      )}
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      {!project.hideCode && project.codeUrl && project.codeUrl !== "#" && (
                        <a
                          href={project.codeUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="w-9 h-9 rounded-lg border border-white/8 flex items-center justify-center text-white/30 hover:text-accent-text hover:border-accent/30 transition-all duration-300"
                          aria-label="View code"
                        >
                          <Github class="w-4 h-4" />
                        </a>
                      )}
                      {project.liveUrl && (
                        <a
                          href={project.liveUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="w-9 h-9 rounded-lg border border-white/8 flex items-center justify-center text-white/30 hover:text-accent-text hover:border-accent/30 transition-all duration-300"
                          aria-label="Visit live site"
                        >
                          <ArrowUpRight class="w-4 h-4" />
                        </a>
                      )}
                    </div>
                  </div>

                  <p class="text-white/40 text-base leading-relaxed max-w-2xl">
                    {project.description}
                  </p>
                </div>

                <div class="flex flex-wrap gap-2">
                  {project.aptitudes.map((tech: string) => (
                    <span class="px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider text-accent-text/50 border border-accent/15 bg-accent/[0.05]">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
