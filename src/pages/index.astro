---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Github, Linkedin, Instagram, Mail } from "lucide-astro";

import logo from "../assets/ysc_logo_no_background.png";

import tokenit from "../assets/projects/tokenit.png";
import tokenitApp from "../assets/projects/app-tokenit.png";
import zatobox from "../assets/projects/zatobox.png";
import consentido from "../assets/projects/consentido.png";

import elevate from "../assets/sideprojects/elevate.png";
import atlas from "../assets/sideprojects/atlas.png";
import aurora from "../assets/sideprojects/aurora.png";
import coffee from "../assets/sideprojects/coffee.png";

const RAIL = [
  { label: "Intro", href: "#top" },
  { label: "Work", href: "#work" },
  { label: "Services", href: "#services" },
  { label: "Archive", href: "#side-projects" },
  { label: "Log", href: "#experience" },
  { label: "Stack", href: "#tech" },
  { label: "Contact", href: "#contact" },
];

const SERVICES = [
  { n: "01", title: "Landing Pages", desc: "High converting landing pages that turn visitors into customers." },
  { n: "02", title: "Business Websites", desc: "Professional websites that represent your brand and grow your business." },
  { n: "03", title: "Portfolio Websites", desc: "Showcase your work with elegant and modern portfolio websites." },
  { n: "04", title: "E-Commerce", desc: "Secure and scalable online stores with the best experience." },
  { n: "05", title: "Web Applications", desc: "Custom web apps built with the right tools for your needs." },
  { n: "06", title: "Maintenance", desc: "Keep your website updated, secure and running smoothly." },
];

const PROJECTS = [
  { n: "01", title: "Tokenit", cat: "Investor App · Web3", img: tokenitApp, alt: "Tokenit Investor App", desc: "Investor dashboard for a Chilean blockchain real-estate platform — real-time monitoring, KYC, digital signing and AI risk scoring.", tags: ["Meteor.js", "React", "Blockchain", "Web3"], url: "https://app.tokenit.cl" },
  { n: "02", title: "Tokenit", cat: "Landing Page · Web3", img: tokenit, alt: "Tokenit Landing", desc: "Public marketplace connecting investors with tokenized real-estate opportunities backed by real assets.", tags: ["Gatsby", "Python", "MongoDB"], url: "https://tokenit.cl" },
  { n: "03", title: "ZatoBox", cat: "Open Source · POS", img: zatobox, alt: "ZatoBox", desc: "Open-source point-of-sale system with real-time inventory, order management and a Docker-based deployment pipeline.", tags: ["Next.js", "TypeScript", "Supabase", "Docker"], url: "https://www.zatobox.io/" },
  { n: "04", title: "ConSentido Cognitivo", cat: "Psicopedagogía · Accessibility", img: consentido, alt: "ConSentido Cognitivo", desc: "Accessible platform for a psychopedagogy practice, built to make cognitive-support resources easy to reach for families.", tags: ["Next.js", "Tailwind CSS", "Firebase"], url: "https://www.consentidocognitivo.site/" },
];

const SIDE_PROJECTS = [
  { title: "Elevate Gym", img: elevate, alt: "Elevate Gym" },
  { title: "Atlas", img: atlas, alt: "Atlas" },
  { title: "Aurora AI", img: aurora, alt: "Aurora AI" },
  { title: "Noma Coffee", img: coffee, alt: "Noma Coffee" },
];

const TIMELINE = [
  { year: "2026", type: "Education", title: "Codigo Facilito", role: "Modern Frontend Bootcamp", date: "Graduated Jan 2026", active: false },
  { year: "2025", type: "Work", title: "Niuro", role: "Full Stack Engineer · Marketplace Platform", desc: "Placed at Tokenit, a Chilean blockchain-based real-estate investment platform. Real-time monitoring, KYC, digital signing and AI risk scoring.", date: "Dec 2025 — Present", active: true },
  { year: "2025", type: "Work", title: "ZatoBox", role: "Full Stack & Cloud Solutions Architect", desc: "DevOps Lead overseeing the full software development lifecycle — architecture from conception to deployment.", date: "Aug — Dec 2025", active: false },
  { year: "2025", type: "Work", title: "Dragon Pyramid", role: "Full Stack Engineer", desc: "Front-end focused work on the Gym Master project — Next.js 14, TailwindCSS, Shadcn UI, NextAuth, Supabase.", date: "Jun — Oct 2025", active: false },
  { year: "2025", type: "Education", title: "Inst. Sup. Santo Domingo", role: "Web Development & Mobile Applications", date: "2025 — Present", active: true },
  { year: "2025", type: "Education", title: "Henry", role: "Full Stack Development Bootcamp", date: "Graduated Jun 2025", active: false },
  { year: "2025", type: "Education", title: "Coderhouse", role: "Full Stack Development Program", date: "Graduated Feb 2025", active: false },
  { year: "2024", type: "Work", title: "YSC by frysccou", role: "Full Stack Engineer & Content Creator", desc: "Independent developer building functional, well-structured digital solutions and creating tech content.", date: "Aug 2024 — Present", active: true },
];

const TECH_STACK = [
  { label: "Core Languages", items: ["HTML", "CSS", "JavaScript", "TypeScript", "Java", "Python", "PHP"] },
  { label: "Frontend", items: ["React", "Vue", "Angular", "Gatsby"] },
  { label: "Backend", items: ["Node.js", "NestJS", "Spring Boot", "Django", "FastAPI", "Laravel"] },
  { label: "Meta-frameworks", items: ["Next.js", "Nuxt.js", "Meteor", "Astro"] },
  { label: "Mobile", items: ["Flutter", "Dart", "React Native"] },
  { label: "Styling & Design", items: ["Tailwind CSS", "Bootstrap", "Figma", "Photoshop"] },
  { label: "Databases", items: ["MongoDB", "Supabase", "Firebase", "MySQL", "PostgreSQL", "Convex"] },
  { label: "Tools & DevOps", items: ["Docker", "GitHub", "Git", "AWS"] },
];

const FOOTER_NAV = [
  { label: "Intro", href: "#top" },
  { label: "Work", href: "#work" },
  { label: "Archive", href: "#side-projects" },
  { label: "Log", href: "#experience" },
  { label: "Stack", href: "#tech" },
];
const FOOTER_SERVICES = SERVICES.map(s => s.title);

const INK = "#1c1512";
const CREAM = "#f2e4d0";
const RED = "#9b1e29";
const LINE = "rgba(28,21,18,.16)";

const STAMP = `<svg viewBox="0 0 60 60" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="1.1">
  <circle cx="30" cy="30" r="28" stroke-dasharray="2 3"/>
  <circle cx="30" cy="30" r="22"/>
  <path d="M30 10l3 5-3 4-3-4z" fill="currentColor" stroke="none"/>
  <text x="30" y="37" text-anchor="middle" font-size="17" fill="currentColor" stroke="none" font-family="'Zen Old Mincho', serif">結</text>
</svg>`;
---

<Layout>
  <div style={`background:${CREAM}; color:${INK}; font-family:'Inter',sans-serif; min-height:100vh;`}>

    <!-- RAIL -->
    <nav class="rail" style={`position:fixed; left:0; top:0; bottom:0; width:56px; border-right:1px solid ${LINE}; z-index:60; display:flex; flex-direction:column; align-items:center; justify-content:space-between; padding:20px 0; background:${CREAM};`}>
      <a href="#top" style="display:flex;"><Image src={logo} alt="YSC" width={1774} height={887} style="width:48px; height:auto; object-fit:contain;" /></a>
      <div style="display:flex; flex-direction:column; align-items:center; gap:30px;">
        {RAIL.map(({ label, href }) => (
          <a href={href} data-rail={href} class="rail-link" style={`writing-mode:vertical-rl; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:${INK}; opacity:.4; text-decoration:none; transition:opacity .2s,color .2s;`}>{label}</a>
        ))}
      </div>
      <div style={`width:20px; height:20px; color:${RED};`} set:html={STAMP} />
    </nav>

    <!-- TOP BAR -->
    <div class="topbar" style={`position:sticky; top:0; z-index:50; display:flex; align-items:center; gap:20px; height:52px; padding:0 clamp(20px,4vw,48px); background:rgba(242,228,208,.9); backdrop-filter:blur(10px); border-bottom:1px solid ${LINE};`}>
      <div class="mobile-nav" style="display:none; overflow-x:auto; gap:16px; flex:1;">
        {RAIL.map(({ label, href }) => (
          <a href={href} style={`font-family:'JetBrains Mono',monospace; font-weight:500; font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; color:${INK}; opacity:.65; text-decoration:none; white-space:nowrap;`}>{label}</a>
        ))}
      </div>
      <a href="#contact" class="avail-link" style={`font-family:'JetBrains Mono',monospace; font-weight:500; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:${INK}; text-decoration:none; display:flex; align-items:center; gap:8px; white-space:nowrap; margin-left:auto;`}>
        <span style={`width:6px; height:6px; background:${RED}; display:inline-block; flex-shrink:0;`}></span> <span class="avail-full">Available for work — get in touch</span><span class="avail-short" style="display:none;">Get in touch</span> ↗
      </a>
    </div>

    <div class="page-body">

    <!-- HERO -->
    <header id="top" class="r-pad" style={`padding:clamp(64px,10vh,120px) clamp(24px,5vw,64px) clamp(40px,6vh,64px); border-bottom:1px solid ${LINE};`}>
      <div style="overflow:hidden; margin-bottom:clamp(28px,5vh,56px);">
        <div class="marquee" style="display:flex; width:max-content; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.2em; text-transform:uppercase; white-space:nowrap;">
          <span style="display:inline-flex; gap:26px; padding-right:26px;">
            {Array.from({ length: 2 }).map(() => (
              <>
                <span style={`color:${RED};`}>結</span><span>Full Stack Engineer</span><span style={`color:${RED};`}>✦</span><span>Buenos Aires, AR</span><span style={`color:${RED};`}>✦</span><span>Est. 2024</span><span style={`color:${RED};`}>✦</span><span>Available for work</span><span style={`color:${RED};`}>✦</span>
              </>
            ))}
          </span>
        </div>
      </div>

      <h1 class="r-h1" style={`font-family:'Poppins',sans-serif; font-weight:900; letter-spacing:-.03em; color:${INK}; line-height:.92;`}>
        <span style="display:block; font-size:clamp(38px,6.4vw,88px);">I build</span>
        <span style="display:block; font-size:clamp(38px,6.4vw,88px); margin-left:clamp(0px,10vw,140px);"><span style={`color:${RED};`}>digital</span> products</span>
        <span style="display:block; font-size:clamp(38px,6.4vw,88px); margin-left:clamp(0px,4vw,60px);">that feel effortless.</span>
      </h1>

      <div class="hero-grid" style="display:grid; grid-template-columns:1.3fr .7fr; gap:clamp(24px,4vw,56px); margin-top:clamp(36px,6vh,64px); align-items:end;">
        <p style="max-width:54ch; font-size:16px; line-height:1.7; color:rgba(28,21,18,.6);">
          Francisco Espindola — Full Stack Engineer crafting fast, elegant and reliable web experiences, from pixel-perfect interfaces to scalable back-end architecture. This page is my open case file: what I've shipped, who I've shipped it for, and how to reach me.
        </p>
        <div class="hero-btns" style="display:flex; flex-direction:column; gap:0;">
          <a href="#contact" class="btn-primary" style={`font-family:'JetBrains Mono',monospace; font-weight:500; font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; color:${CREAM}; text-decoration:none; background:${RED}; padding:16px 24px; border:1px solid ${RED}; text-align:center;`}>Start a project →</a>
          <a href="#work" class="btn-outline hero-btn-2" style={`font-family:'JetBrains Mono',monospace; font-weight:500; font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; color:${INK}; text-decoration:none; background:transparent; padding:16px 24px; border:1px solid ${INK}; border-top:none; text-align:center;`}>View the work</a>
        </div>
      </div>
    </header>

    <!-- SERVICES -->
    <section id="services" class="r-pad" style={`padding:clamp(56px,9vh,100px) clamp(24px,5vw,64px); border-bottom:1px solid ${LINE};`}>
      <div style="display:flex; align-items:baseline; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:clamp(28px,5vh,48px);">
        <h2 style={`font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:${RED};`}>Services — what I can do for you</h2>
        <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(28,21,18,.4);">{SERVICES.length} disciplines</span>
      </div>

      <div style={`border-top:1px solid ${INK};`}>
        {SERVICES.map(({ n, title, desc }) => (
          <div class="menu-row" style={`border-bottom:1px solid ${LINE};`}>
            <div style="display:flex; align-items:center; gap:18px; padding:20px 4px; cursor:default;">
              <span style={`font-family:'JetBrains Mono',monospace; font-size:11px; color:${RED}; flex-shrink:0;`}>{n}</span>
              <h3 class="menu-title" style={`font-family:'Poppins',sans-serif; font-weight:700; font-size:clamp(20px,2.6vw,30px); color:${INK}; white-space:nowrap;`}>{title}</h3>
              <span class="leader" style={`flex:1; border-bottom:1px dotted rgba(28,21,18,.3); margin:0 4px; transform:translateY(-6px);`}></span>
            </div>
            <div class="menu-desc" style="max-height:0; overflow:hidden; transition:max-height .35s ease;">
              <p style="font-size:13.5px; line-height:1.6; color:rgba(28,21,18,.55); padding:0 4px 20px 40px; max-width:56ch;">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FEATURED WORK -->
    <section id="work" class="r-pad" style={`padding:clamp(56px,9vh,100px) clamp(24px,5vw,64px) 0; border-bottom:1px solid ${LINE};`}>
      <div style="display:flex; align-items:baseline; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:clamp(28px,5vh,48px);">
        <h2 style={`font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:${RED};`}>Work — selected exhibits</h2>
        <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(28,21,18,.4);">{PROJECTS.length} case files</span>
      </div>

      {PROJECTS.map(({ n, title, cat, img, alt, desc, tags, url }, i) => (
        <article class="exhibit" style={`position:relative; display:grid; grid-template-columns:${i % 2 === 0 ? '1.1fr .9fr' : '.9fr 1.1fr'}; gap:clamp(24px,4vw,56px); align-items:center; padding:clamp(36px,6vh,64px) 0; border-bottom:1px solid ${LINE}; overflow:hidden;`}>
          <span aria-hidden="true" style={`position:absolute; top:-4vw; ${i % 2 === 0 ? 'right:-1vw' : 'left:-1vw'}; font-family:'Poppins',sans-serif; font-weight:900; font-size:clamp(120px,20vw,280px); line-height:1; color:${INK}; opacity:.04; pointer-events:none; z-index:0;`}>{n}</span>

          <div class="exhibit-media" style={`position:relative; z-index:1; order:${i % 2 === 0 ? 1 : 2}; border:1px solid ${LINE}; overflow:hidden;`}>
            <Image src={img} alt={alt} width={800} height={500} class="proj-img" style="width:100%; aspect-ratio:16/10; display:block; object-fit:cover; object-position:top; transition:transform .6s ease;" />
          </div>

          <div style={`position:relative; z-index:1; order:${i % 2 === 0 ? 2 : 1};`}>
            <div style={`font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:${RED}; margin-bottom:10px;`}>Exhibit №{n} — {cat}</div>
            <h3 style={`font-family:'Poppins',sans-serif; font-weight:800; font-size:clamp(28px,3.6vw,44px); color:${INK}; line-height:1; margin-bottom:16px;`}>{title}</h3>
            <p style="font-size:14.5px; line-height:1.7; color:rgba(28,21,18,.6); max-width:48ch; margin-bottom:20px;">{desc}</p>
            <div style="display:flex; flex-wrap:wrap; gap:7px; margin-bottom:24px;">
              {tags.map(t => <span style={`font-family:'JetBrains Mono',monospace; font-size:10px; padding:4px 10px; border:1px solid ${LINE}; color:rgba(28,21,18,.55);`}>{t}</span>)}
            </div>
            <a href={url} target="_blank" rel="noopener noreferrer" class="exhibit-link" style={`display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-weight:500; font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:${INK}; text-decoration:none; border-bottom:1px solid ${INK}; padding-bottom:3px;`}>Open case file <span>↗</span></a>
          </div>
        </article>
      ))}
    </section>

    <!-- SIDE PROJECTS -->
    <section id="side-projects" style={`padding:clamp(56px,9vh,100px) 0; border-bottom:1px solid ${LINE};`}>
      <div class="r-pad" style="display:flex; align-items:baseline; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:clamp(28px,5vh,44px); padding-left:clamp(24px,5vw,64px); padding-right:clamp(24px,5vw,64px);">
        <h2 style={`font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:${RED};`}>Archive — visual reel</h2>
        <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(28,21,18,.4);">Scroll to browse →</span>
      </div>

      <div class="reel" style="display:flex; justify-content:safe center; gap:16px; overflow-x:auto; padding:0 clamp(24px,5vw,64px) 12px; scroll-snap-type:x proximity;">
        {SIDE_PROJECTS.map(({ title, img, alt }, i) => (
          <button class="sp-card" data-index={i} style={`all:unset; cursor:pointer; flex:0 0 auto; width:min(72vw,300px); scroll-snap-align:start; border:1px solid ${LINE};`}>
            <div style="overflow:hidden;">
              <Image src={img} alt={alt} width={600} height={420} style="width:100%; aspect-ratio:4/3; display:block; object-fit:cover; filter:grayscale(1); transition:filter .5s ease, transform .5s ease;" class="sp-img" />
            </div>
            <div style={`padding:12px 14px; border-top:1px solid ${LINE}; display:flex; align-items:center; justify-content:space-between; gap:8px;`}>
              <span style={`font-family:'JetBrains Mono',monospace; font-size:10px; color:${RED};`}>0{i + 1}</span>
              <h3 style={`font-family:'Poppins',sans-serif; font-weight:600; font-size:13.5px; color:${INK}; margin:0;`}>{title}</h3>
            </div>
          </button>
        ))}
      </div>
    </section>

    <!-- MODAL SIDE PROJECTS -->
    <div id="sp-modal" style="display:none; position:fixed; inset:0; z-index:200; background:rgba(12,9,10,.94); align-items:center; justify-content:center;">
      <button id="sp-close" style={`all:unset; cursor:pointer; position:absolute; top:22px; right:28px; z-index:10; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:${CREAM}; border:1px solid rgba(245,230,210,.35); padding:10px 18px;`}>✕ Close</button>
      <button id="sp-prev" style={`all:unset; cursor:pointer; position:absolute; left:24px; top:50%; transform:translateY(-50%); z-index:10; width:44px; height:44px; border:1px solid rgba(245,230,210,.35); display:flex; align-items:center; justify-content:center; color:${CREAM}; font-size:18px;`}>←</button>
      <button id="sp-next" style={`all:unset; cursor:pointer; position:absolute; right:24px; top:50%; transform:translateY(-50%); z-index:10; width:44px; height:44px; border:1px solid rgba(245,230,210,.35); display:flex; align-items:center; justify-content:center; color:${CREAM}; font-size:18px;`}>→</button>

      <div style={`position:relative; width:min(90vw,760px); max-height:88vh; overflow-y:auto; border:1px solid rgba(245,230,210,.3); background:${CREAM};`}>
        <div style={`padding:20px 24px; border-bottom:1px solid ${LINE}; position:sticky; top:0; background:${CREAM}; z-index:5;`}>
          <div id="sp-modal-num" style={`font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:${RED}; margin-bottom:4px;`}></div>
          <h3 id="sp-modal-title" style={`font-family:'Poppins',sans-serif; font-weight:700; font-size:22px; color:${INK}; margin:0;`}></h3>
        </div>
        <img id="sp-modal-img" src="" alt="" style="width:100%; display:block;" />
      </div>
    </div>

    <!-- EXPERIENCE / LOG -->
    <section id="experience" class="r-pad" style={`padding:clamp(56px,9vh,100px) clamp(24px,5vw,64px); border-bottom:1px solid ${LINE};`}>
      <div style="display:flex; align-items:baseline; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:clamp(28px,5vh,48px);">
        <h2 style={`font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:${RED};`}>Log — where I've been</h2>
        <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(28,21,18,.4);">Work &amp; education, reverse-chronological</span>
      </div>

      {Object.entries(
        TIMELINE.reduce((acc, entry) => {
          (acc[entry.year] ||= []).push(entry);
          return acc;
        }, {})
      ).sort((a, b) => b[0] - a[0]).map(([year, entries]) => (
        <div class="log-year" style={`display:grid; grid-template-columns:140px 1fr; gap:clamp(16px,3vw,32px); border-top:1px solid ${INK}; padding:clamp(20px,3vh,32px) 0;`}>
          <div style={`font-family:'Poppins',sans-serif; font-weight:900; font-size:clamp(40px,5vw,64px); color:${INK}; line-height:1;`}>{year}</div>
          <div>
            {entries.map(({ type, title, role, desc, date, active }) => (
              <div style="padding:14px 0; display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:start;">
                <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:.1em; text-transform:uppercase; color:${RED}; border:1px solid rgba(155,30,41,.4); padding:3px 8px; margin-top:3px; white-space:nowrap;`}>{type}</span>
                <div>
                  <div style="display:flex; align-items:center; gap:9px; flex-wrap:wrap; margin-bottom:3px;">
                    {active && <span style={`width:6px; height:6px; background:${RED}; display:inline-block; border-radius:50%;`}></span>}
                    <h4 style={`font-family:'Poppins',sans-serif; font-weight:700; font-size:16.5px; color:${INK};`}>{title}</h4>
                    <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:rgba(28,21,18,.4);">{date}</span>
                  </div>
                  <div style="font-family:'Inter',sans-serif; font-weight:600; font-size:12.5px; color:rgba(28,21,18,.6); margin-bottom:4px;">{role}</div>
                  {desc && <p style="font-size:12.5px; line-height:1.6; color:rgba(28,21,18,.5); max-width:60ch;">{desc}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- FULL TECH STACK -->
    <section id="tech" class="r-pad" style={`padding:clamp(56px,9vh,100px) clamp(24px,5vw,64px); border-bottom:1px solid ${LINE};`}>
      <div style="display:flex; align-items:baseline; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:clamp(28px,5vh,44px);">
