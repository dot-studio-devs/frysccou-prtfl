---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import tokenit from "../assets/projects/tokenit.png";
import tokenitApp from "../assets/projects/app-tokenit.png";
import zatobox from "../assets/projects/zatobox.png";
import consentido from "../assets/projects/consentido.png";
import liz from "../assets/projects/liz.png";
import lastaurinas from "../assets/projects/lastaurinas.png";
import dotStudio from "../assets/projects/dot-studio.png";
---

<Layout>
  <div style="background:#1a1517; color:#F2EBE7; font-family:'Zen Kaku Gothic New',sans-serif; min-height:100vh; position:relative; overflow:hidden;">

    <!-- ambient blobs -->
    <div style="position:fixed; top:-200px; right:-160px; width:620px; height:620px; border-radius:50%; background:radial-gradient(circle, rgba(207,49,71,.16), transparent 62%); pointer-events:none; z-index:0;"></div>
    <div style="position:fixed; top:1100px; left:-220px; width:560px; height:560px; border-radius:50%; background:radial-gradient(circle, rgba(89,31,40,.4), transparent 64%); pointer-events:none; z-index:0;"></div>

    <!-- side rails -->
    <div class="r-rail" style="position:fixed; left:26px; top:0; bottom:0; z-index:30; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; pointer-events:none; mix-blend-mode:screen;">
      <div style="width:1px; height:80px; background:linear-gradient(transparent, #591F28);"></div>
      <div style="writing-mode:vertical-rl; font-family:'Zen Old Mincho',serif; font-size:19px; letter-spacing:.32em; color:#F2EBE7; opacity:.5;">結 — 工房</div>
      <div style="writing-mode:vertical-rl; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.5em; color:#CF3147; opacity:.85; text-transform:uppercase;">YSC&nbsp;STUDIO</div>
      <div style="width:1px; height:80px; background:linear-gradient(#591F28, transparent);"></div>
    </div>
    <div class="r-rail" style="position:fixed; right:26px; top:0; bottom:0; z-index:30; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; pointer-events:none; mix-blend-mode:screen;">
      <div style="width:1px; height:80px; background:linear-gradient(transparent, #591F28);"></div>
      <div style="writing-mode:vertical-rl; font-family:'Zen Old Mincho',serif; font-size:19px; letter-spacing:.32em; color:#F2EBE7; opacity:.5;">開発 — 設計</div>
      <div style="writing-mode:vertical-rl; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.5em; color:#F2EBE7; opacity:.4; text-transform:uppercase;">BUENOS&nbsp;AIRES</div>
      <div style="width:1px; height:80px; background:linear-gradient(#591F28, transparent);"></div>
    </div>

    <!-- NAV -->
    <nav style="position:sticky; top:0; z-index:50; display:flex; align-items:center; justify-content:space-between; padding:14px clamp(28px,6vw,96px); background:rgba(26,21,23,.72); backdrop-filter:blur(14px); border-bottom:1px solid rgba(89,31,40,.45);">
      <a href="#top" style="display:flex; align-items:center; gap:12px; text-decoration:none;">
        <img src="/ysc-2d.png" alt="YSC" style="width:50px; height:54px; object-fit:contain; display:block;" />
      </a>
      <div style="display:flex; align-items:center; gap:clamp(16px,2.6vw,34px); font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.22em; text-transform:uppercase;">
        <a href="#work" class="r-navlink nav-link" style="color:#F2EBE7; text-decoration:none; opacity:.78; transition:color .2s,opacity .2s;">Work</a>
        <a href="#about" class="r-navlink nav-link" style="color:#F2EBE7; text-decoration:none; opacity:.78; transition:color .2s,opacity .2s;">About</a>
        <a href="#stack" class="r-navlink nav-link" style="color:#F2EBE7; text-decoration:none; opacity:.78; transition:color .2s,opacity .2s;">Stack</a>
        <a href="#contact" class="nav-cta" style="display:inline-flex; align-items:center; gap:8px; color:#F2EBE7; text-decoration:none; border:1px solid #591F28; padding:9px 16px; border-radius:3px; transition:border-color .2s,color .2s;">Contact <span style="color:#CF3147;">↗</span></a>
      </div>
    </nav>

    <!-- HERO -->
    <header id="top" class="r-hero r-pad" style="position:relative; z-index:10; display:grid; grid-template-columns:1.15fr .85fr; gap:clamp(32px,5vw,80px); align-items:center; padding:clamp(56px,9vh,110px) clamp(28px,6vw,96px) clamp(60px,8vh,96px);">
      <div style="animation:ysc-rise .7s ease both;">
        <div style="display:inline-flex; align-items:center; gap:10px; padding:7px 14px; border:1px solid #591F28; border-radius:100px; font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:.22em; text-transform:uppercase; color:#F2EBE7; margin-bottom:34px;">
          <span style="width:7px; height:7px; border-radius:50%; background:#CF3147; animation:ysc-pulse 1.8s ease-in-out infinite;"></span>
          Available for work
        </div>
        <h1 class="r-h1" style="font-family:'Zen Old Mincho',serif; font-weight:900; font-size:clamp(52px,8vw,124px); line-height:.92; letter-spacing:-.01em; color:#F2EBE7; margin-bottom:10px;">
          Build something<br><span style="color:#CF3147;">worth remembering.</span>
        </h1>
        <p style="max-width:48ch; font-size:clamp(15px,1.4vw,18px); line-height:1.7; color:rgba(242,235,231,.66); margin:26px 0 38px;">
          YSC is the studio of <span style="color:#F2EBE7;">Francisco Espindola</span> — a Full Stack Engineer building premium digital products end to end, from pixel-perfect interfaces to scalable system architecture. If it's on the web, I engineer it right.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:14px;">
          <a href="#work" class="btn-primary" style="display:inline-flex; align-items:center; gap:10px; background:#CF3147; color:#F2EBE7; text-decoration:none; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.2em; text-transform:uppercase; padding:16px 26px; border-radius:3px; transition:background .2s;">View work <span>→</span></a>
          <a href="#contact" class="btn-outline" style="display:inline-flex; align-items:center; gap:10px; background:transparent; color:#F2EBE7; text-decoration:none; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:.2em; text-transform:uppercase; padding:16px 26px; border:1px solid #591F28; border-radius:3px; transition:border-color .2s,color .2s;">Get in touch</a>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:26px; margin-top:46px; font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:.18em; text-transform:uppercase; color:rgba(242,235,231,.45);">
          <span>Full-Stack Engineer</span>
          <span style="color:#591F28;">/</span>
          <span>Studio</span>
          <span style="color:#591F28;">/</span>
          <span>Buenos Aires, AR</span>
        </div>
      </div>

      <div class="r-visual" style="position:relative; min-height:clamp(420px,52vh,580px); display:flex; align-items:center; justify-content:center; animation:ysc-rise .9s ease both;">
        <div style="position:absolute; top:50%; left:52%; transform:translate(-50%,-54%); width:min(94%,440px); aspect-ratio:1/1; border-radius:50%; border:1px solid rgba(89,31,40,.55); box-shadow:inset 0 0 80px rgba(207,49,71,.08);"></div>
        <div style="position:absolute; top:50%; left:52%; transform:translate(-50%,-54%); width:min(70%,330px); aspect-ratio:1/1; border-radius:50%; background:radial-gradient(circle, rgba(207,49,71,.22), transparent 66%); filter:blur(6px);"></div>
        <div style="position:absolute; top:50%; left:52%; transform:translate(-50%,-54%); width:min(102%,470px); aspect-ratio:1/1; border-radius:50%; border:1px dashed rgba(242,235,231,.10); animation:ysc-spin 60s linear infinite;"></div>
        <div style="position:absolute; top:8%; right:2%; writing-mode:vertical-rl; font-family:'Zen Old Mincho',serif; font-size:15px; letter-spacing:.3em; color:rgba(242,235,231,.5);">壱 — 守護</div>
        <img src="/YSC3D.png" alt="YSC emblem" style="position:relative; z-index:2; width:min(86%,400px); height:auto; display:block; filter:drop-shadow(0 40px 50px rgba(0,0,0,.7)) drop-shadow(0 0 40px rgba(207,49,71,.18)); animation:ysc-float 6s ease-in-out infinite;" />
        <div style="position:absolute; bottom:6%; left:50%; transform:translateX(-50%); width:54%; height:26px; border-radius:50%; background:radial-gradient(ellipse, rgba(0,0,0,.55), transparent 70%); filter:blur(5px); z-index:1;"></div>
        <div style="position:absolute; bottom:4%; right:6%; z-index:3; width:84px; height:84px; border:2px solid #CF3147; border-radius:8px; background:rgba(26,21,23,.85); backdrop-filter:blur(4px); display:grid; place-items:center; animation:ysc-seal 5s ease-in-out infinite; box-shadow:0 14px 30px -10px rgba(0,0,0,.7);">
          <span style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:34px; color:#CF3147; line-height:1;">結</span>
        </div>
      </div>
    </header>

    <!-- MARQUEE -->
    <div style="position:relative; z-index:10; border-top:1px solid rgba(89,31,40,.5); border-bottom:1px solid rgba(89,31,40,.5); overflow:hidden; padding:16px 0; background:rgba(38,38,38,.35);">
      <div style="display:flex; width:max-content; animation:ysc-marquee 26s linear infinite; font-family:'Zen Old Mincho',serif; font-size:18px; letter-spacing:.04em; white-space:nowrap;">
        <span style="display:inline-flex; gap:34px; padding-right:34px; color:rgba(242,235,231,.62);">
          <span>System Architecture</span><span style="color:#CF3147;">✦</span><span>Full-Stack Engineering</span><span style="color:#CF3147;">✦</span><span>Premium Interfaces</span><span style="color:#CF3147;">✦</span><span>Motion &amp; Interaction</span><span style="color:#CF3147;">✦</span><span>Performance</span><span style="color:#CF3147;">✦</span>
        </span>
        <span aria-hidden="true" style="display:inline-flex; gap:34px; padding-right:34px; color:rgba(242,235,231,.62);">
          <span>System Architecture</span><span style="color:#CF3147;">✦</span><span>Full-Stack Engineering</span><span style="color:#CF3147;">✦</span><span>Premium Interfaces</span><span style="color:#CF3147;">✦</span><span>Motion &amp; Interaction</span><span style="color:#CF3147;">✦</span><span>Performance</span><span style="color:#CF3147;">✦</span>
        </span>
      </div>
    </div>

    <!-- SELECTED WORK -->
    <section id="work" style="position:relative; z-index:10; padding:clamp(64px,10vh,120px) clamp(28px,6vw,96px);">
      <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:54px;">
        <div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.34em; text-transform:uppercase; color:#CF3147; margin-bottom:18px;">壱 — Selected Work</div>
          <h2 style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:clamp(36px,5vw,68px); line-height:1; color:#F2EBE7;">Real products,<br>shipped.</h2>
        </div>
        <p style="max-width:36ch; font-size:14px; line-height:1.7; color:rgba(242,235,231,.55);">A selection of work — from full-stack platforms to premium interfaces, owned end to end.</p>
      </div>

      <!-- FEATURED: Tokenit -->
      <article class="card" style="border:1px solid rgba(89,31,40,.45); border-radius:6px; padding:clamp(20px,2.6vw,34px); background:linear-gradient(150deg,rgba(38,38,38,.45),rgba(26,21,23,.2)); margin-bottom:26px; transition:border-color .2s;">
        <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:22px;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em; color:#CF3147;">01</span>
          <h3 style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:clamp(30px,3.4vw,46px); color:#F2EBE7;">Tokenit</h3>
          <span style="font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.2em; text-transform:uppercase; color:#F2EBE7; border:1px solid #CF3147; border-radius:100px; padding:5px 12px;">2 products</span>
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:rgba(242,235,231,.45);">Investor Platform · Web3</span>
        </div>
        <p style="font-size:14.5px; line-height:1.75; color:rgba(242,235,231,.64); max-width:88ch; margin-bottom:26px;">
          A Chilean collective financing platform enabling online investment in fixed real-estate returns through blockchain-tokenized assets. I own both the public marketplace and the investor app — built for accessibility, transparency and Web3 traceability.
        </p>
        <div class="r-2" style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
          <div style="border:1px solid rgba(89,31,40,.5); border-radius:5px; padding:16px; background:rgba(12,8,9,.4);">
            <a href="https://app.tokenit.cl" target="_blank" rel="noopener noreferrer" style="display:block; position:relative; aspect-ratio:16/9; border-radius:4px; overflow:hidden; margin-bottom:14px;">
              <Image src={tokenitApp} alt="Tokenit Investor App" width={640} height={360} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
            </a>
            <div style="font-family:'Zen Old Mincho',serif; font-size:18px; color:#F2EBE7; margin-bottom:4px;">Investor App</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.12em; color:#CF3147; margin-bottom:8px;">app.tokenit.cl</div>
            <p style="font-size:12.5px; line-height:1.6; color:rgba(242,235,231,.55);">Real-time portfolio monitoring, KYC, digital signing and AI-powered risk scoring.</p>
          </div>
          <div style="border:1px solid rgba(89,31,40,.5); border-radius:5px; padding:16px; background:rgba(12,8,9,.4);">
            <a href="https://tokenit.cl" target="_blank" rel="noopener noreferrer" style="display:block; position:relative; aspect-ratio:16/9; border-radius:4px; overflow:hidden; margin-bottom:14px;">
              <Image src={tokenit} alt="Tokenit Landing" width={640} height={360} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
            </a>
            <div style="font-family:'Zen Old Mincho',serif; font-size:18px; color:#F2EBE7; margin-bottom:4px;">Landing &amp; Marketplace</div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.12em; color:#CF3147; margin-bottom:8px;">tokenit.cl</div>
            <p style="font-size:12.5px; line-height:1.6; color:rgba(242,235,231,.55);">Public-facing landing and marketplace for blockchain-tokenized real-estate assets.</p>
          </div>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:7px;">
          {["Meteor.js","React","Gatsby","Python","Node.js","MongoDB","Blockchain","Web3","MercadoPago","AI"].map(t => (
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.08em; padding:5px 10px; border:1px solid rgba(89,31,40,.6); border-radius:100px; color:rgba(242,235,231,.6);">{t}</span>
          ))}
        </div>
      </article>

      <!-- GRID -->
      <div class="r-2" style="display:grid; grid-template-columns:repeat(2,1fr); gap:26px;">

        <!-- ZatoBox -->
        <article class="card" style="border:1px solid rgba(89,31,40,.45); border-radius:6px; padding:clamp(18px,2.2vw,26px); background:linear-gradient(150deg,rgba(38,38,38,.4),rgba(26,21,23,.2)); display:flex; flex-direction:column; transition:border-color .2s;">
          <div style="position:relative; aspect-ratio:16/10; border-radius:4px; overflow:hidden; border:1px solid rgba(89,31,40,.5); margin-bottom:18px;">
            <Image src={zatobox} alt="ZatoBox" width={640} height={400} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
            <span style="position:absolute; top:12px; left:12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em; color:#CF3147;">02</span>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:rgba(242,235,231,.45); margin-bottom:10px;">Open Source · Point of Sale</div>
          <h3 style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:26px; color:#F2EBE7; margin-bottom:12px;">ZatoBox</h3>
          <p style="font-size:13.5px; line-height:1.65; color:rgba(242,235,231,.6); margin-bottom:18px; flex:1;">A modular, open-source POS for SMEs — cloud inventory, online catalogs with ZatoLink, payments via ZatoConnect, and upcoming smart-inventory and automation modules.</p>
          <div style="display:flex; flex-wrap:wrap; gap:7px;">
            {["Next.js","TypeScript","Supabase","Docker","BTC Server"].map(t => (
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; padding:5px 10px; border:1px solid rgba(89,31,40,.6); border-radius:100px; color:rgba(242,235,231,.6);">{t}</span>
            ))}
          </div>
        </article>

        <!-- ConSentido -->
        <article class="card" style="border:1px solid rgba(89,31,40,.45); border-radius:6px; padding:clamp(18px,2.2vw,26px); background:linear-gradient(150deg,rgba(38,38,38,.4),rgba(26,21,23,.2)); display:flex; flex-direction:column; transition:border-color .2s;">
          <div style="position:relative; aspect-ratio:16/10; border-radius:4px; overflow:hidden; border:1px solid rgba(89,31,40,.5); margin-bottom:18px;">
            <Image src={consentido} alt="ConSentido Cognitivo" width={640} height={400} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
            <span style="position:absolute; top:12px; left:12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em; color:#CF3147;">03</span>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:rgba(242,235,231,.45); margin-bottom:10px;">Psicopedagogía · Accessibility</div>
          <h3 style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:26px; color:#F2EBE7; margin-bottom:12px;">ConSentido Cognitivo</h3>
          <p style="font-size:13.5px; line-height:1.65; color:rgba(242,235,231,.6); margin-bottom:18px; flex:1;">An informational, accessible site for neurocognitive stimulation for older adults — downloadable resources and cognitive workshops focused on active aging.</p>
          <div style="display:flex; flex-wrap:wrap; gap:7px;">
            {["Next.js","Tailwind CSS","Firebase"].map(t => (
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; padding:5px 10px; border:1px solid rgba(89,31,40,.6); border-radius:100px; color:rgba(242,235,231,.6);">{t}</span>
            ))}
          </div>
        </article>

        <!-- Liz -->
        <article class="card" style="border:1px solid rgba(89,31,40,.45); border-radius:6px; padding:clamp(18px,2.2vw,26px); background:linear-gradient(150deg,rgba(38,38,38,.4),rgba(26,21,23,.2)); display:flex; flex-direction:column; transition:border-color .2s;">
          <div style="position:relative; aspect-ratio:16/10; border-radius:4px; overflow:hidden; border:1px solid rgba(89,31,40,.5); margin-bottom:18px;">
            <Image src={liz} alt="Liz" width={640} height={400} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
            <span style="position:absolute; top:12px; left:12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em; color:#CF3147;">04</span>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:rgba(242,235,231,.45); margin-bottom:10px;">Product · Anime &amp; Manga</div>
          <h3 style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:26px; color:#F2EBE7; margin-bottom:12px;">Liz</h3>
          <p style="font-size:13.5px; line-height:1.65; color:rgba(242,235,231,.6); margin-bottom:18px; flex:1;">A modern, responsive web app for anime &amp; manga fans — discover trending content, advanced search, progress tracking and custom lists, powered by the AniList API.</p>
          <div style="display:flex; flex-wrap:wrap; gap:7px;">
            {["Vue 3","Pinia","Supabase","AniList API","Vite"].map(t => (
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; padding:5px 10px; border:1px solid rgba(89,31,40,.6); border-radius:100px; color:rgba(242,235,231,.6);">{t}</span>
            ))}
          </div>
        </article>

        <!-- Las Taurinas -->
        <article class="card" style="border:1px solid rgba(89,31,40,.45); border-radius:6px; padding:clamp(18px,2.2vw,26px); background:linear-gradient(150deg,rgba(38,38,38,.4),rgba(26,21,23,.2)); display:flex; flex-direction:column; transition:border-color .2s;">
          <div style="position:relative; aspect-ratio:16/10; border-radius:4px; overflow:hidden; border:1px solid rgba(89,31,40,.5); margin-bottom:18px;">
            <Image src={lastaurinas} alt="Las Taurinas" width={640} height={400} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
            <span style="position:absolute; top:12px; left:12px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em; color:#CF3147;">05</span>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:rgba(242,235,231,.45); margin-bottom:10px;">E-commerce · Retail</div>
          <h3 style="font-family:'Zen Old Mincho',serif; font-weight:700; font-size:26px; color:#F2EBE7; margin-bottom:12px;">Las Taurinas</h3>
          <p style="font-size:13.5px; line-height:1.65; color:rgba(242,235,231,.6); margin-bottom:18px; flex:1;">A modern e-commerce on Empretienda with Andreani shipping, custom CSS3 styling and secure payments via Mercado Pago and bank transfer — fully responsive, seamless UX.</p>
          <div style="display:flex; flex-wrap:wrap; gap:7px;">
            {["Empretienda","Andreani","CSS3","Mercado Pago"].map(t => (
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; padding:5px 10px; border:1px solid rgba(89,31,40,.6); border-radius:100px; color:rgba(242,235,231,.6);">{t}</span>
            ))}
          </div>
        </article>

        <!-- Dot Studio — full width -->
        <article class="card" style="border:1px solid rgba(89,31,40,.45); border-radius:6px; padding:clamp(18px,2.2vw,26px); background:linear-gradient(150deg,rgba(38,38,38,.4),rgba(26,21,23,.2)); display:flex; flex-direction:column; grid-column:1 / -1; transition:border-color .2s;">
          <div class="r-2" style="display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(18px,2.6vw,40px); align-items:center;">
            <div style="position:relative; aspect-ratio:16/9; border-radius:4px; overflow:hidden; border:1px solid rgba(89,31,40,.5);">
              <Image src={dotStudio} alt="Dot Studio" width={640} height={360} style="width:100%; height:100%; object-fit:cover; opacity:.75;" />
