<script>
  const PROJECTS = [
    { title: "Elevate Gym", num: "01" },
    { title: "Atlas", num: "02" },
    { title: "Aurora AI", num: "03" },
    { title: "Noma Coffee", num: "04" },
  ];

  const modal = document.getElementById('sp-modal');
  const modalTitle = document.getElementById('sp-modal-title');
  const modalNum = document.getElementById('sp-modal-num');
  const modalImg = document.getElementById('sp-modal-img');
  const closeBtn = document.getElementById('sp-close');
  const prevBtn = document.getElementById('sp-prev');
  const nextBtn = document.getElementById('sp-next');

  let current = 0;
  const cards = document.querySelectorAll('.sp-card');
  const imgs = document.querySelectorAll('.sp-card img');

  function getImgSrc(index) {
    return imgs[index]?.src ?? '';
  }

  function openModal(index) {
    current = index;
    modalTitle.textContent = PROJECTS[index].title;
    modalNum.textContent = PROJECTS[index].num + ' / 04';
    modalImg.src = getImgSrc(index);
    modalImg.alt = PROJECTS[index].title;
    modal.style.display = 'flex';
    modal.querySelector('div[style*="overflow-y"]').scrollTop = 0;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function navigate(dir) {
    current = (current + dir + PROJECTS.length) % PROJECTS.length;
    openModal(current);
  }

  cards.forEach((card, i) => {
    card.addEventListener('click', () => openModal(i));
    card.addEventListener('mouseenter', () => {
      card.querySelector('.sp-overlay').style.opacity = '1';
      card.querySelector('.sp-hint').style.opacity = '1';
      card.querySelector('.sp-img').style.transform = 'scale(1.03)';
    });
    card.addEventListener('mouseleave', () => {
      card.querySelector('.sp-overlay').style.opacity = '0';
      card.querySelector('.sp-hint').style.opacity = '0';
      card.querySelector('.sp-img').style.transform = 'scale(1)';
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  prevBtn?.addEventListener('click', () => navigate(-1));
  nextBtn?.addEventListener('click', () => navigate(1));

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (modal.style.display === 'none') return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });
</script>

