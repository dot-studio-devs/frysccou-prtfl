---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
---

<Layout
  title="About — YSC by frysccou"
  description="Francisco Espindola (frysccou) — Full Stack Engineer from Buenos Aires. Background, experience, stack, and philosophy of work."
>
  <main class="pt-32">
    <div class="max-w-7xl mx-auto px-8 sm:px-12 pb-16">
      <div class="mb-16 space-y-5">
        <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-accent/70 block">
          The engineer
        </span>
        <h1 class="text-7xl md:text-9xl font-[Outfit] font-black text-white leading-[0.88] tracking-tighter">
          About.
        </h1>
      </div>
    </div>

    <About />
    <Experience />
    <Skills />
  </main>

  <Footer />
</Layout>
